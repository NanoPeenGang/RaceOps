# --- Database (Neon/Supabase managed Postgres) ---
DATABASE_URL="postgresql://user:password@localhost:5432/raceops"
# Optional: direct (unpooled) connection for migrations. The Neon Vercel
# integration sets DATABASE_URL_UNPOOLED automatically; other providers can
# use DIRECT_URL. Falls back to DATABASE_URL when unset.
# DIRECT_URL=""

# --- Clerk auth ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Clerk webhook signing secret (Dashboard -> Webhooks)
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# --- Stripe (Phase 2) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Recurring price ids for the two paid tiers (Stripe dashboard -> Products)
STRIPE_PRICE_RECRUITER="price_..."
STRIPE_PRICE_SPONSOR="price_..."

# Absolute URL of the app, used for Stripe redirect URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Upstash Redis (rate limiting / caching) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Anthropic AI gateway (Phase 5) ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- Email (Phase 2) ---
RESEND_API_KEY=""
# Verified sender for notification emails
RESEND_FROM="RaceOps <notifications@yourdomain.com>"

# --- Realtime (Phase 4) ---
# Optional. Without all four, live timing and paddock chat fall back to
# polling, which works — updates just arrive on the next tick.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""

# --- Sim integrations (Phase 3) ---
IRACING_CLIENT_ID=""
IRACING_CLIENT_SECRET=""

# --- Object storage for direct uploads (Cloudflare R2, S3, MinIO) ---
# All five must be set for the file picker to appear; without them the UI
# falls back to attach-by-URL, which works fine and always has.
S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
S3_BUCKET="raceops-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# R2 ignores this but the SigV4 signature still needs one.
S3_REGION="auto"
# Where objects are publicly readable from, e.g. an R2 custom domain.
S3_PUBLIC_BASE_URL="https://media.example.com"

# --- Platform staff ---
# The platform owner: always an admin, never demotable, and the reason a fresh
# deployment has somebody who can open the access-application queue on day one.
# An address is baked into src/server/services/platform-admin.ts, so this is
# only needed to hand the platform over or to run a staging copy under a
# different account.
PLATFORM_OWNER_EMAIL=

# Further sign-in addresses granted platform admin regardless of the database
# column, comma-separated. Read live at request time alongside the owner, so
# whoever controls the deployment can always reach the queue even if every
# admin row in the database has been demoted, and removing an address revokes
# on the next request rather than leaving a stale grant behind.
PLATFORM_ADMIN_EMAILS=
