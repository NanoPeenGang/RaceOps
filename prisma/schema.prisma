generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & Profiles
// ---------------------------------------------------------------------------

enum ProfileType {
  DRIVER
  CREW
  ENGINEER
  SPONSOR
  TEAM_MANAGER
  INDUSTRY_PRO
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

model User {
  id                     String             @id @default(cuid())
  email                  String             @unique
  authProviderId         String             @unique // Clerk user id
  profileTypes           ProfileType[]
  verificationStatus     VerificationStatus @default(UNVERIFIED)
  stripeCustomerId       String?            @unique
  stripeConnectAccountId String?            @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  profile                Profile?
  teamMemberships        TeamMembership[]
  applications           Application[]
  sponsorshipProfile     SponsorshipProfile?
  raceReports            RaceReport[]
  endorsementsGiven      Endorsement[]       @relation("EndorsementFrom")
  endorsementsReceived   Endorsement[]       @relation("EndorsementTo")
  opportunitiesPosted    Opportunity[]       @relation("OpportunityPostedByUser")
  raceEntries            RaceEntry[]
  media                  Media[]
  subscriptions          Subscription[]
  notifications          Notification[]
  seriesMemberships      SeriesMembership[]
  registrationsEntered   EventRegistration[] @relation("RegistrationEntrant")
  registrationsSubmitted EventRegistration[] @relation("RegistrationSubmitter")
  volunteerSignups       VolunteerSignup[]
  strategyPlans          StrategyPlan[]
  penaltiesIssued        Penalty[]           @relation("PenaltyIssuer")
  appealsFiled           PenaltyAppeal[]     @relation("AppealFiler")
  appealsDecided         PenaltyAppeal[]     @relation("AppealDecider")

  @@index([verificationStatus])
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  displayName  String
  bio          String?  @db.Text
  location     String?
  availability String?
  // Per-platform sim stats, e.g. { "iracing": { "iRating": 3200, "sr": "A 4.2", "licenseClass": "A" } }
  simStats     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  realWorldCredentials RealWorldCredential[]
  industryExperience   IndustryExperience[]

  @@index([location])
}

model RealWorldCredential {
  id        String   @id @default(cuid())
  profileId String
  // e.g. "FIA_LICENSE", "KARTING", "SAFETY_CERT"
  kind      String
  title     String
  issuer    String?
  year      Int?
  details   String?  @db.Text
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model IndustryExperience {
  id        String   @id @default(cuid())
  profileId String
  role      String
  company   String
  years     Int
  summary   String?  @db.Text
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

enum MediaVisibility {
  PUBLIC
  ORGANIZERS_ONLY
}

/**
 * Media is scoped by optional attachment points: post-race coverage hangs off
 * a series/event/team, while penalty and appeal evidence hangs off those.
 */
model Media {
  id         String          @id @default(cuid())
  ownerId    String
  url        String
  // e.g. "image", "video", "telemetry"
  kind       String
  title      String?
  visibility MediaVisibility @default(PUBLIC)
  createdAt  DateTime        @default(now())

  seriesId  String?
  eventId   String?
  teamId    String?
  penaltyId String?
  appealId  String?

  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  raceReports RaceReport[]
  series      Series?        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  event       RaceEvent?     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team        Team?          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  penalty     Penalty?       @relation(fields: [penaltyId], references: [id], onDelete: Cascade)
  appeal      PenaltyAppeal? @relation(fields: [appealId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([seriesId])
  @@index([eventId])
  @@index([teamId])
  @@index([penaltyId])
  @@index([appealId])
}

// ---------------------------------------------------------------------------
// Teams
// ---------------------------------------------------------------------------

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  logoUrl     String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roster        TeamMembership[]
  opportunities Opportunity[]       @relation("OpportunityPostedByTeam")
  registrations EventRegistration[]
  strategyPlans StrategyPlan[]
  media         Media[]
}

enum TeamRole {
  OWNER
  MANAGER
  DRIVER
  CREW
  ENGINEER
  MEMBER
}

model TeamMembership {
  id        String    @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole  @default(MEMBER)
  startDate DateTime  @default(now())
  endDate   DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Opportunities marketplace
// ---------------------------------------------------------------------------

enum OpportunityType {
  SEAT
  CREW_JOB
  SPONSORSHIP
}

enum OpportunityStatus {
  DRAFT
  OPEN
  CLOSED
}

model Opportunity {
  id             String            @id @default(cuid())
  type           OpportunityType
  status         OpportunityStatus @default(OPEN)
  title          String
  description    String            @db.Text
  requirements   Json?
  compensation   String?
  location       String?
  series         String?
  postedByTeamId String?
  postedByUserId String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  postedByTeam Team?         @relation("OpportunityPostedByTeam", fields: [postedByTeamId], references: [id], onDelete: SetNull)
  postedByUser User?         @relation("OpportunityPostedByUser", fields: [postedByUserId], references: [id], onDelete: SetNull)
  applications Application[]

  @@index([type, status])
  @@index([postedByTeamId])
  @@index([postedByUserId])
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Application {
  id            String            @id @default(cuid())
  opportunityId String
  applicantId   String
  status        ApplicationStatus @default(SUBMITTED)
  coverNote     String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicant   User        @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, applicantId])
  @@index([applicantId])
}

model SponsorshipProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  budgetNeed      String?
  audienceMetrics Json?
  pitchDeckUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Billing (Stripe) & notifications
// ---------------------------------------------------------------------------

enum SubscriptionTier {
  RECRUITER
  SPONSOR_DISCOVERY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  tier                 SubscriptionTier
  status               SubscriptionStatus
  stripeSubscriptionId String             @unique
  currentPeriodEnd     DateTime
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tier])
  @@index([userId, status])
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_STATUS_CHANGED
  OPPORTUNITY_CLOSED
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?          @db.Text
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Racing events, content & strategy
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Series & event organization
// ---------------------------------------------------------------------------

enum SeriesDiscipline {
  REAL_WORLD
  SIM
}

/**
 * A championship/series run by organizers — the top-level organizer object.
 */
model Series {
  id               String           @id @default(cuid())
  name             String           @unique
  slug             String           @unique
  description      String?          @db.Text
  discipline       SeriesDiscipline
  // Sanctioning body (real world) or sim platform name.
  platform         String
  season           String?
  logoUrl          String?
  /// Position -> points map, e.g. {"1": 25, "2": 18}. Null uses the default.
  pointsScheme     Json?
  /// Bonus points for the fastest lap, when the series awards one.
  fastestLapPoints Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organizers SeriesMembership[]
  events     RaceEvent[]
  media      Media[]
}

enum SeriesRole {
  OWNER
  ADMIN
  RACE_CONTROL
  STEWARD
  VOLUNTEER_COORDINATOR
}

model SeriesMembership {
  id        String     @id @default(cuid())
  seriesId  String
  userId    String
  role      SeriesRole @default(ADMIN)
  createdAt DateTime   @default(now())

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seriesId, userId])
  @@index([userId])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELED
}

model RaceEvent {
  id          String      @id @default(cuid())
  name        String
  // Free-text series label, kept for events not run through a managed Series.
  seriesLabel String
  seriesId    String?
  date        DateTime
  // Real-world venue or sim platform name ("iRacing", "Le Mans Ultimate", ...)
  platform    String
  venue       String?
  description String?     @db.Text
  status      EventStatus @default(DRAFT)

  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  /// Max confirmed entries; null means unlimited. Overflow is waitlisted.
  entryCapacity        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  series          Series?             @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  participants    RaceEntry[]
  strategyPlans   StrategyPlan[]
  registrations   EventRegistration[]
  volunteerShifts VolunteerShift[]
  results         EventResult[]
  penalties       Penalty[]
  media           Media[]

  @@index([seriesLabel, date])
  @@index([seriesId, date])
  @@index([status, date])
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  REJECTED
  WITHDRAWN
}

/**
 * An entry request for an event, from either a team or an individual.
 * Exactly one of teamId / entrantUserId is set (enforced in the router).
 */
model EventRegistration {
  id            String             @id @default(cuid())
  eventId       String
  teamId        String?
  entrantUserId String?
  submittedById String
  carNumber     String?
  carClass      String?
  notes         String?            @db.Text
  status        RegistrationStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  event       RaceEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  entrantUser User?        @relation("RegistrationEntrant", fields: [entrantUserId], references: [id], onDelete: Cascade)
  submittedBy User         @relation("RegistrationSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  result      EventResult?
  penalties   Penalty[]

  @@unique([eventId, teamId])
  @@unique([eventId, entrantUserId])
  @@unique([eventId, carNumber])
  @@index([eventId, status])
  @@index([submittedById])
}

enum ResultStatus {
  FINISHED
  DNF
  DNS
  DSQ
}

/**
 * Classified finish for one entry. Drives series standings.
 */
model EventResult {
  id             String       @id @default(cuid())
  eventId        String
  registrationId String       @unique
  finishPosition Int?
  status         ResultStatus @default(FINISHED)
  lapsCompleted  Int?
  fastestLap     Boolean      @default(false)
  /// Manual override; when null, points come from the series points scheme.
  pointsOverride Int?
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  event        RaceEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

enum PenaltyType {
  TIME_PENALTY
  DRIVE_THROUGH
  STOP_GO
  GRID_DROP
  POINTS_DEDUCTION
  DISQUALIFICATION
  WARNING
  FINE
}

enum PenaltyStatus {
  ISSUED
  UNDER_APPEAL
  UPHELD
  REDUCED
  OVERTURNED
}

/**
 * A penalty issued by race control against an entry. Public by design:
 * penalties surface on the competitor's series profile.
 */
model Penalty {
  id             String        @id @default(cuid())
  eventId        String
  registrationId String
  issuedById     String
  type           PenaltyType
  status         PenaltyStatus @default(ISSUED)
  summary        String
  details        String?       @db.Text
  /// Regulation or article the decision cites.
  regulation     String?
  lapNumber      Int?

  // Magnitudes — only the field matching `type` is meaningful.
  timeSeconds    Int?
  gridPlaces     Int?
  /// Championship points removed; feeds standings while the penalty stands.
  pointsDeducted Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event        RaceEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  issuedBy     User              @relation("PenaltyIssuer", fields: [issuedById], references: [id], onDelete: Cascade)
  appeal       PenaltyAppeal?
  media        Media[]

  @@index([eventId])
  @@index([registrationId])
  @@index([status])
}

enum AppealStatus {
  SUBMITTED
  UNDER_REVIEW
  UPHELD
  REJECTED
}

/**
 * A competitor's challenge to a penalty. One appeal per penalty.
 */
model PenaltyAppeal {
  id          String       @id @default(cuid())
  penaltyId   String       @unique
  filedById   String
  statement   String       @db.Text
  status      AppealStatus @default(SUBMITTED)
  decision    String?      @db.Text
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  penalty   Penalty @relation(fields: [penaltyId], references: [id], onDelete: Cascade)
  filedBy   User    @relation("AppealFiler", fields: [filedById], references: [id], onDelete: Cascade)
  decidedBy User?   @relation("AppealDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  media     Media[]

  @@index([filedById])
  @@index([status])
}

enum VolunteerRoleType {
  MARSHAL
  FLAG
  TIMING
  SCRUTINEER
  MEDICAL
  GRID
  PIT_LANE
  MEDIA
  OTHER
}

model VolunteerShift {
  id       String            @id @default(cuid())
  eventId  String
  role     VolunteerRoleType
  title    String
  startsAt DateTime
  endsAt   DateTime
  /// Number of volunteers needed; overflow signups are waitlisted.
  capacity Int
  notes    String?           @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   RaceEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  signups VolunteerSignup[]

  @@index([eventId, startsAt])
}

enum VolunteerSignupStatus {
  SIGNED_UP
  WAITLISTED
  CONFIRMED
  CANCELED
}

model VolunteerSignup {
  id        String                @id @default(cuid())
  shiftId   String
  userId    String
  status    VolunteerSignupStatus @default(SIGNED_UP)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  shift VolunteerShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId])
  @@index([userId])
  @@index([shiftId, status])
}

model RaceEntry {
  id       String  @id @default(cuid())
  eventId  String
  userId   String
  carClass String?
  result   Json?

  event RaceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model RaceReport {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  body      String   @db.Text
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author           User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mediaAttachments Media[]

  @@index([authorId])
  @@index([tags])
}

model StrategyPlan {
  id      String  @id @default(cuid())
  eventId String
  /// Author — always set; plans are private to the author unless shared.
  ownerId String
  /// When set, every active member of this team can read the plan.
  teamId  String?

  name           String
  stintPlan      Json?
  fuelStrategy   Json?
  driverRotation Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event RaceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  owner User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  team  Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([ownerId])
  @@index([teamId])
}

// ---------------------------------------------------------------------------
// Social
// ---------------------------------------------------------------------------

enum EndorsementCategory {
  RACECRAFT
  ENGINEERING
  TEAMWORK
  STRATEGY
  PROFESSIONALISM
  SPONSORSHIP_VALUE
}

model Endorsement {
  id         String              @id @default(cuid())
  fromUserId String
  toUserId   String
  note       String?             @db.Text
  category   EndorsementCategory
  createdAt  DateTime            @default(now())

  fromUser User @relation("EndorsementFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("EndorsementTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId, category])
  @@index([toUserId])
}
