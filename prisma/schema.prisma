generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & Profiles
// ---------------------------------------------------------------------------

enum ProfileType {
  DRIVER
  CREW
  ENGINEER
  SPONSOR
  TEAM_MANAGER
  INDUSTRY_PRO
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

/**
 * What someone actually does in sim racing. `ProfileType` is the broad
 * category ("engineer"); these are the specific jobs people search for.
 */
enum SimRole {
  // Driving
  ENDURANCE_DRIVER
  SPRINT_DRIVER
  OVAL_DRIVER
  RALLY_DRIVER
  DRIFT_DRIVER
  TIME_ATTACK_DRIVER
  // Engineering & pit wall
  RACE_ENGINEER
  SETUP_ENGINEER
  STRATEGIST
  SPOTTER
  DRIVER_COACH
  // Running a team or a league
  TEAM_PRINCIPAL
  LEAGUE_ADMIN
  RACE_CONTROL
  STEWARD
  // Media & creative
  BROADCASTER
  COMMENTATOR
  CONTENT_CREATOR
  LIVERY_ARTIST
  GRAPHIC_DESIGNER
  OTHER
}

/**
 * The same idea for real-world motorsport, paddock roles included.
 */
enum RealWorldRole {
  // Driving
  DRIVER
  CO_DRIVER
  KART_DRIVER
  DRIVER_COACH
  // Engineering
  RACE_ENGINEER
  DATA_ENGINEER
  PERFORMANCE_ENGINEER
  // Crew
  MECHANIC
  CREW_CHIEF
  TIRE_TECHNICIAN
  FABRICATOR
  TRANSPORT_LOGISTICS
  // Pit wall & management
  TEAM_MANAGER
  TEAM_OWNER
  STRATEGIST
  SPOTTER
  // Officials & trackside
  RACE_DIRECTOR
  STEWARD
  MARSHAL
  SCRUTINEER
  TIMING_OFFICIAL
  MEDICAL
  SAFETY_CREW
  // Media
  COMMENTATOR
  PHOTOGRAPHER
  VIDEOGRAPHER
  JOURNALIST
  // Commercial
  PR_COMMUNICATIONS
  SPONSORSHIP_SALES
  HOSPITALITY
  OTHER
}

model User {
  id                     String             @id @default(cuid())
  email                  String             @unique
  authProviderId         String             @unique // Clerk user id
  profileTypes           ProfileType[]
  verificationStatus     VerificationStatus @default(UNVERIFIED)
  stripeCustomerId       String?            @unique
  stripeConnectAccountId String?            @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  profile                Profile?
  teamMemberships        TeamMembership[]
  applications           Application[]
  sponsorshipProfile     SponsorshipProfile?
  raceReports            RaceReport[]
  endorsementsGiven      Endorsement[]            @relation("EndorsementFrom")
  endorsementsReceived   Endorsement[]            @relation("EndorsementTo")
  opportunitiesPosted    Opportunity[]            @relation("OpportunityPostedByUser")
  raceEntries            RaceEntry[]
  media                  Media[]
  subscriptions          Subscription[]
  notifications          Notification[]
  seriesMemberships      SeriesMembership[]
  registrationsEntered   EventRegistration[]      @relation("RegistrationEntrant")
  registrationsSubmitted EventRegistration[]      @relation("RegistrationSubmitter")
  volunteerSignups       VolunteerSignup[]
  strategyPlans          StrategyPlan[]
  penaltiesIssued        Penalty[]                @relation("PenaltyIssuer")
  appealsFiled           PenaltyAppeal[]          @relation("AppealFiler")
  appealsDecided         PenaltyAppeal[]          @relation("AppealDecider")
  documentsUploaded      RaceDocument[]
  announcements          Announcement[]
  chatMessages           ChatMessage[]
  lineupEntries          RegistrationDriver[]
  waiversReceived        RequirementWaiver[]      @relation("WaiverSubject")
  waiversDecided         RequirementWaiver[]      @relation("WaiverDecider")
  inspectionsPerformed   Inspection[]
  incidentsReported      Incident[]               @relation("IncidentReportedBy")
  incidentsDecided       Incident[]               @relation("IncidentDecidedBy")
  incidentResponses      IncidentResponse[]
  sponsorshipsOffered    Sponsorship[]            @relation("SponsorshipSponsor")
  sponsorshipsCreated    Sponsorship[]            @relation("SponsorshipCreator")
  tracksCreated          Track[]                  @relation("TrackCreator")
  trackImages            TrackImage[]             @relation("TrackImageUploader")
  credentialScans        CredentialScan[]         @relation("CredentialScanner")
  conditionsRecorded     SessionCondition[]       @relation("ConditionRecorder")
  carsOwned              Car[]                    @relation("CarOwner")
  carsCreated            Car[]                    @relation("CarCreator")
  transpondersOwned      Transponder[]            @relation("TransponderOwner")
  tireSetsAllocated      TireSet[]                @relation("TireAllocator")
  orgMemberships         OrganizationMembership[]
  staffAssignments       StaffAssignment[]
  paddockAssignments     PaddockAllocation[]      @relation("PaddockAssigner")
  credentialsHeld        Credential[]             @relation("CredentialHolder")
  logEntries             OfficialLogEntry[]       @relation("LogOfficial")
  auditEvents            AuditEvent[]             @relation("AuditActor")
  waiversAuthored        Waiver[]                 @relation("WaiverAuthor")
  waiverSignatures       WaiverSignature[]        @relation("WaiverSigner")
  inventoryCreated       InventoryItem[]          @relation("InventoryCreator")
  stockMovements         InventoryMovement[]      @relation("StockMover")
  garageFilesUploaded    GarageFile[]             @relation("GarageFileUploader")
  garageFilesDriven      GarageFile[]             @relation("GarageFileDriver")
  servicesPerformed      CarService[]             @relation("ServicePerformer")
  servicesCreated        CarService[]             @relation("ServiceCreator")
  pitStopsCreated        PitStopPlan[]            @relation("PitStopCreator")
  channelsCreated        ChatChannel[]            @relation("ChannelCreator")
  threadsCreated         DirectThread[]           @relation("ThreadCreator")
  threadParticipations   DirectParticipant[]      @relation("ThreadParticipant")
  interviewsCreated      Interview[]              @relation("InterviewCreator")
  offersCreated          Offer[]                  @relation("OfferCreator")
  payRates               PayRate[]                @relation("PayRateSubject")
  payRatesCreated        PayRate[]                @relation("PayRateCreator")
  payRunsCreated         PayRun[]                 @relation("PayRunCreator")
  payRunsApproved        PayRun[]                 @relation("PayRunApprover")
  payrollLines           PayrollLine[]            @relation("PayrollPayee")

  @@index([verificationStatus])
}

model Profile {
  id             String          @id @default(cuid())
  userId         String          @unique
  displayName    String
  /// Uploaded or linked. Falls back to initials rather than a stock silhouette.
  avatarUrl      String?
  bio            String?         @db.Text
  location       String?
  availability   String?
  /// Needed only where a series enforces a minimum age.
  dateOfBirth    DateTime?
  /// Specific sim-racing jobs this person does, for discovery.
  simRoles       SimRole[]
  /// Specific real-world motorsport jobs this person does.
  realWorldRoles RealWorldRole[]
  // Per-platform sim stats, e.g. { "iracing": { "iRating": 3200, "sr": "A 4.2", "licenseClass": "A" } }
  simStats       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  realWorldCredentials RealWorldCredential[]
  industryExperience   IndustryExperience[]

  @@index([location])
  // Array containment filters ("has this role") need GIN to stay fast.
  @@index([simRoles], type: Gin)
  @@index([realWorldRoles], type: Gin)
}

model RealWorldCredential {
  id        String   @id @default(cuid())
  profileId String
  // e.g. "FIA_LICENSE", "KARTING", "SAFETY_CERT"
  kind      String
  title     String
  issuer    String?
  year      Int?
  details   String?  @db.Text
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model IndustryExperience {
  id        String   @id @default(cuid())
  profileId String
  role      String
  company   String
  years     Int
  summary   String?  @db.Text
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

enum MediaVisibility {
  PUBLIC
  ORGANIZERS_ONLY
}

/**
 * Media is scoped by optional attachment points: post-race coverage hangs off
 * a series/event/team, while penalty and appeal evidence hangs off those.
 */
model Media {
  id         String          @id @default(cuid())
  ownerId    String
  url        String
  // e.g. "image", "video", "telemetry"
  kind       String
  title      String?
  visibility MediaVisibility @default(PUBLIC)
  createdAt  DateTime        @default(now())

  seriesId   String?
  eventId    String?
  teamId     String?
  penaltyId  String?
  appealId   String?
  reportId   String?
  incidentId String?

  owner    User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  series   Series?        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  event    RaceEvent?     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team     Team?          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  penalty  Penalty?       @relation(fields: [penaltyId], references: [id], onDelete: Cascade)
  appeal   PenaltyAppeal? @relation(fields: [appealId], references: [id], onDelete: Cascade)
  report   RaceReport?    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  incident Incident?      @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([seriesId])
  @@index([eventId])
  @@index([teamId])
  @@index([penaltyId])
  @@index([appealId])
  @@index([reportId])
  @@index([incidentId])
}

// ---------------------------------------------------------------------------
// Teams
// ---------------------------------------------------------------------------

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  logoUrl     String?
  description String?  @db.Text
  /// Public-facing links shown on the team's landing page.
  websiteUrl  String?
  homeBase    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roster         TeamMembership[]
  opportunities  Opportunity[]       @relation("OpportunityPostedByTeam")
  registrations  EventRegistration[]
  strategyPlans  StrategyPlan[]
  media          Media[]
  sponsorships   Sponsorship[]
  chatMessages   ChatMessage[]
  channels       ChatChannel[]
  cars           Car[]
  inventory      InventoryItem[]
  garageFiles    GarageFile[]
  offers         Offer[]
  payRates       PayRate[]
  payRuns        PayRun[]
  transponders   Transponder[]
  organizationId String?
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branding       Branding?
}

enum SponsorshipStatus {
  /// A sponsor has proposed a deal the team has not answered yet.
  OFFERED
  /// Terms are being worked out.
  NEGOTIATING
  /// Signed and running.
  ACTIVE
  /// The team said no, or the sponsor withdrew.
  DECLINED
  /// Ran its course.
  EXPIRED
}

/**
 * A sponsorship deal or offer against a team.
 * `sponsorUserId` links a RaceOps sponsor account when the offer came through
 * the platform; `sponsorName` is always set so a team can also record deals
 * agreed offline with companies that have no account here.
 */
model Sponsorship {
  id            String            @id @default(cuid())
  teamId        String
  sponsorUserId String?
  sponsorName   String
  contactEmail  String?
  websiteUrl    String?
  logoUrl       String?
  /// Free-text package label, e.g. "Primary", "Associate", "Contingency".
  tier          String?
  /// Deal value in minor units (cents) to avoid float rounding.
  valueMinor    Int?
  currency      String            @default("USD")
  status        SponsorshipStatus @default(OFFERED)
  season        String?
  startDate     DateTime?
  endDate       DateTime?
  notes         String?           @db.Text
  /// Who put this record in — a sponsor making an offer, or a team manager.
  createdById   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  team        Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sponsorUser User? @relation("SponsorshipSponsor", fields: [sponsorUserId], references: [id], onDelete: SetNull)
  createdBy   User  @relation("SponsorshipCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@index([sponsorUserId])
  @@index([createdById])
}

enum TeamRole {
  OWNER
  MANAGER
  DRIVER
  CREW
  ENGINEER
  MEMBER
}

model TeamMembership {
  id        String    @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole  @default(MEMBER)
  startDate DateTime  @default(now())
  endDate   DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Opportunities marketplace
// ---------------------------------------------------------------------------

enum OpportunityType {
  SEAT
  CREW_JOB
  SPONSORSHIP
}

enum OpportunityStatus {
  DRAFT
  OPEN
  CLOSED
}

model Opportunity {
  id             String            @id @default(cuid())
  type           OpportunityType
  status         OpportunityStatus @default(OPEN)
  title          String
  description    String            @db.Text
  requirements   Json?
  compensation   String?
  location       String?
  series         String?
  postedByTeamId String?
  postedByUserId String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  postedByTeam Team?         @relation("OpportunityPostedByTeam", fields: [postedByTeamId], references: [id], onDelete: SetNull)
  postedByUser User?         @relation("OpportunityPostedByUser", fields: [postedByUserId], references: [id], onDelete: SetNull)
  applications Application[]

  @@index([type, status])
  @@index([postedByTeamId])
  @@index([postedByUserId])
}

/**
 * Where an application has got to.
 *
 * Two routes reach ACCEPTED and both are legitimate. A team can simply say
 * yes — most club hiring is a conversation and a handshake — or it can run the
 * pipeline: review, interview, offer, and let the applicant answer. Forcing
 * every team through the paperwork would make the feature something people
 * work around.
 */
enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  /// An interview is proposed or booked.
  INTERVIEWING
  /// A formal offer is out and unanswered.
  OFFERED
  /// Hired. Either the team said yes outright, or the applicant accepted an
  /// offer.
  ACCEPTED
  REJECTED
  /// The applicant pulled out before any offer.
  WITHDRAWN
  /// The applicant turned down an offer. Kept apart from WITHDRAWN because it
  /// is a different fact about the team: an offer that was refused is worth
  /// knowing when the next one is written.
  OFFER_DECLINED
}

model Application {
  id            String            @id @default(cuid())
  opportunityId String
  applicantId   String
  status        ApplicationStatus @default(SUBMITTED)
  coverNote     String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicant   User        @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  interviews  Interview[]
  offers      Offer[]

  @@unique([opportunityId, applicantId])
  @@index([applicantId])
  @@index([status])
}

model SponsorshipProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  budgetNeed      String?
  audienceMetrics Json?
  pitchDeckUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Billing (Stripe) & notifications
// ---------------------------------------------------------------------------

enum SubscriptionTier {
  RECRUITER
  SPONSOR_DISCOVERY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  tier                 SubscriptionTier
  status               SubscriptionStatus
  stripeSubscriptionId String             @unique
  currentPeriodEnd     DateTime
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tier])
  @@index([userId, status])
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_STATUS_CHANGED
  OPPORTUNITY_CLOSED
  /// Somebody messaged you directly. Raised only for a thread you are not
  /// currently reading; see src/server/services/notifications.ts.
  DIRECT_MESSAGE
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?          @db.Text
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Racing events, content & strategy
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Series & event organization
// ---------------------------------------------------------------------------

enum SeriesDiscipline {
  REAL_WORLD
  SIM
}

/**
 * A championship/series run by organizers — the top-level organizer object.
 */
model Series {
  id                String           @id @default(cuid())
  name              String           @unique
  slug              String           @unique
  description       String?          @db.Text
  discipline        SeriesDiscipline
  // Sanctioning body (real world) or sim platform name.
  platform          String
  season            String?
  logoUrl           String?
  /// Position -> points map, e.g. {"1": 25, "2": 18}. Null uses the default.
  pointsScheme      Json?
  /// Bonus points for the fastest lap, when the series awards one.
  fastestLapPoints  Int?
  /**
   * Score only this many best rounds ("best 8 of 10"). Null counts every
   * round. Dropped scores are near-universal outside top-flight professional
   * championships.
   */
  countBestRounds   Int?
  /// Rounds a competitor must start to be eligible for the title.
  minStartsForTitle Int?
  /**
   * A championship shipped with the platform rather than created by a user:
   * a published calendar and rule set, seeded so somebody can look up when
   * and where a series runs and what it requires before they have any account
   * relationship with it.
   *
   * Unlike a reference *track*, this is not open to correction by anyone. A
   * circuit's length is a fact; a championship's regulations are that
   * organizer's to state, and a wiki-editable rule book would be worse than
   * none. Reference series are updated by re-seeding, or by the organizer
   * taking ownership of the row.
   */
  isReference       Boolean          @default(false)
  /// Where the seeded copy came from, so a reader can check it themselves.
  sourceUrl         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organizationId      String?
  organization        Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branding            Branding?
  staffRoles          StaffRole[]
  staffAssignments    StaffAssignment[]
  organizers          SeriesMembership[]
  events              RaceEvent[]
  media               Media[]
  documents           RaceDocument[]
  announcements       Announcement[]
  classes             SeriesClass[]
  requirements        EntryRequirement[]
  inspectionTemplates InspectionTemplate[]
  transponders        Transponder[]
  waivers             Waiver[]
  rules               SeriesRule[]
  channels            ChatChannel[]
}

/**
 * What part of a rule book a regulation belongs to.
 *
 * Grouped the way a competitor reads them rather than the way a rule book is
 * numbered: the first question is always "can my car run", and the last is
 * always "what happens if I get it wrong".
 */
enum SeriesRuleKind {
  /// What may be entered: classes, performance caps, homologation.
  ELIGIBILITY
  /// Cage, seat, harness, fire system, personal equipment.
  SAFETY
  /// Licence, minimum drivers, stint limits, driver change procedure.
  DRIVERS
  /// Race length, pit stops, fuelling, service restrictions.
  FORMAT
  /// How the championship is scored.
  SCORING
  /// Flags, conduct, contact, penalties and appeals.
  CONDUCT
  /// Entry fees, deadlines, transponders, paperwork.
  ENTRY
  OTHER
}

/**
 * One regulation a championship imposes.
 *
 * Structured rather than a PDF because the questions people actually ask —
 * "how many drivers do I need for a 14-hour race", "what is the points cap" —
 * are answerable from a field, and are not answerable from a link to a
 * 90-page document somebody has to search.
 *
 * The PDF still matters, which is what `sourceUrl` and `citation` are for: a
 * summary that cannot be checked against the rule book is a summary nobody
 * should build a car to. `verifiedOn` exists because rule books are revised
 * every winter and a stale points cap is worse than a missing one.
 */
model SeriesRule {
  id         String         @id @default(cuid())
  seriesId   String
  kind       SeriesRuleKind
  /// The rule in one line: "Vehicle points cap: 500".
  title      String
  /// What a competitor needs to know, in prose.
  detail     String?        @db.Text
  /// Where it lives in the rule book: "BCCR v1.4 §4.2".
  citation   String?
  sourceUrl  String?
  /// Display order within a kind; lower first.
  sortOrder  Int            @default(0)
  /// When somebody last checked this against the rule book. Null = never.
  verifiedOn DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([seriesId, kind, sortOrder])
}

/**
 * A class within a championship.
 * Deliberately free-form. A professional grid might run GT3 and GT4; a club
 * autocross region runs dozens of classes with names nobody outside the region
 * would recognise ("ST-X", "Improved Production <2L", "Novice"). Classes are
 * therefore records a series creates rather than a fixed list, and a series
 * that runs a single grid simply declares none.
 */
model SeriesClass {
  id               String   @id @default(cuid())
  seriesId         String
  /// Full name as it appears in the regulations and on results.
  name             String
  /// Short code for entry lists and timing sheets, e.g. "SM", "GT3".
  code             String?
  /**
   * Optional grouping — a run group, division or category that several classes
   * share. Autocross and track-day organizers group classes into run groups
   * that are not themselves championships.
   */
  grouping         String?
  /// Display and results order; lower sorts first.
  sortOrder        Int      @default(0)
  /// Per-class points scale. Null inherits the series scheme.
  pointsScheme     Json?
  /// Per-class fastest-lap bonus. Null inherits the series value.
  fastestLapPoints Int?
  /// Retired classes stay for historical results but take no new entries.
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  series        Series              @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@unique([seriesId, name])
  @@index([seriesId, sortOrder])
}

enum SeriesRole {
  OWNER
  ADMIN
  RACE_CONTROL
  STEWARD
  VOLUNTEER_COORDINATOR
}

model SeriesMembership {
  id        String     @id @default(cuid())
  seriesId  String
  userId    String
  role      SeriesRole @default(ADMIN)
  createdAt DateTime   @default(now())

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seriesId, userId])
  @@index([userId])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELED
}

model RaceEvent {
  id            String      @id @default(cuid())
  name          String
  // Free-text series label, kept for events not run through a managed Series.
  seriesLabel   String
  seriesId      String?
  date          DateTime
  /// Final day for a multi-day meeting; null for a single-day event.
  endDate       DateTime?
  // Real-world venue or sim platform name ("iRacing", "Le Mans Ultimate", ...)
  platform      String
  /// Free text, kept for venues with no Track record and for one-off bookings.
  venue         String?
  /// The configuration being run, where the venue is a known track.
  trackLayoutId String?
  description   String?     @db.Text
  status        EventStatus @default(DRAFT)

  /// Weighting for a double-points finale and the like; 1 is a normal round.
  pointsMultiplier Float @default(1)

  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  /// Max confirmed entries; null means unlimited. Overflow is waitlisted.
  entryCapacity        Int?

  // Line-up regulations. All null for a sprint event with a single driver.
  /// Drivers that must be declared before an entry can be confirmed.
  minDriversPerEntry       Int?
  maxDriversPerEntry       Int?
  /// Longest a single driver may stay in the car, in minutes.
  maxStintMinutes          Int?
  /// Shortest countable stint, used to stop a token driver change.
  minStintMinutes          Int?
  /// Cap on one driver's total time across the event, in minutes.
  maxDriveMinutesPerDriver Int?
  /// Least time each declared driver must complete, in minutes.
  minDriveMinutesPerDriver Int?

  /// Sets of tires each entry may use across the meeting; null is unlimited.
  tireSetAllowance Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  series           Series?             @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  trackLayout      TrackLayout?        @relation(fields: [trackLayoutId], references: [id], onDelete: SetNull)
  participants     RaceEntry[]
  strategyPlans    StrategyPlan[]
  registrations    EventRegistration[]
  volunteerShifts  VolunteerShift[]
  results          EventResult[]
  penalties        Penalty[]
  media            Media[]
  sessions         EventSession[]
  documents        RaceDocument[]
  announcements    Announcement[]
  chatMessages     ChatMessage[]
  channels         ChatChannel[]
  raceReports      RaceReport[]
  incidents        Incident[]
  garageFiles      GarageFile[]
  carServices      CarService[]
  stockMovements   InventoryMovement[]
  payRuns          PayRun[]
  payrollLines     PayrollLine[]
  tireSets         TireSet[]
  paddock          PaddockAllocation[]
  credentialTypes  CredentialType[]
  credentials      Credential[]
  credentialScans  CredentialScan[]
  officialLog      OfficialLogEntry[]
  waivers          Waiver[]
  branding         Branding?
  staffAssignments StaffAssignment[]

  @@index([seriesLabel, date])
  @@index([seriesId, date])
  @@index([status, date])
  @@index([trackLayoutId, date])
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  REJECTED
  WITHDRAWN
}

/**
 * An entry request for an event, from either a team or an individual.
 * Exactly one of teamId / entrantUserId is set (enforced in the router).
 */
model EventRegistration {
  id            String             @id @default(cuid())
  eventId       String
  teamId        String?
  entrantUserId String?
  submittedById String
  carNumber     String?
  /// Free-text class, kept for entries outside a series that declares classes.
  carClass      String?
  /// The declared class this entry is scored in, when the series has any.
  seriesClassId String?
  /// The car being entered, where the entrant keeps car records.
  carId         String?
  notes         String?            @db.Text
  status        RegistrationStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  event            RaceEvent               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team             Team?                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  entrantUser      User?                   @relation("RegistrationEntrant", fields: [entrantUserId], references: [id], onDelete: Cascade)
  submittedBy      User                    @relation("RegistrationSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  result           EventResult?
  penalties        Penalty[]
  timingEntries    TimingEntry[]
  lineup           RegistrationDriver[]
  stints           Stint[]
  waivers          RequirementWaiver[]
  inspections      Inspection[]
  incidentsAbout   Incident[]              @relation("IncidentSubject")
  incidentsFiled   Incident[]              @relation("IncidentReporter")
  car              Car?                    @relation(fields: [carId], references: [id], onDelete: SetNull)
  transponders     TransponderAssignment[]
  tireSets         TireSet[]
  paddock          PaddockAllocation?
  credentials      Credential[]
  waiverSignatures WaiverSignature[]
  seriesClass      SeriesClass?            @relation(fields: [seriesClassId], references: [id], onDelete: SetNull)
  pitStops         PitStopPlan[]

  @@unique([eventId, teamId])
  @@unique([eventId, entrantUserId])
  @@unique([eventId, carNumber])
  @@index([eventId, status])
  @@index([submittedById])
  @@index([seriesClassId])
}

// ---------------------------------------------------------------------------
// Endurance line-ups & drive time
// ---------------------------------------------------------------------------

enum LineupRole {
  /// Counts for the drivers' championship when a series awards to one driver.
  DRIVER_OF_RECORD
  DRIVER
  /// Nominated but only drives if needed; does not block drive-time rules.
  RESERVE
}

/**
 * A driver declared on one entry. Endurance racing puts several drivers in a
 * single car, so the crew is a list rather than the single `entrantUserId`
 * that suits a sprint entry.
 */
model RegistrationDriver {
  id             String     @id @default(cuid())
  registrationId String
  userId         String
  role           LineupRole @default(DRIVER)
  /// Driver rating/grade as the series classifies it, e.g. "Bronze", "Am".
  grade          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  registration  EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  stints        Stint[]
  pitStopsIn    PitStopPlan[]     @relation("PitStopDriverIn")
  pitStopsOut   PitStopPlan[]     @relation("PitStopDriverOut")

  @@unique([registrationId, userId])
  @@index([userId])
}

/**
 * One driver's time in the car. Logged by the team or race control and used to
 * check drive-time regulations, which are enforced per driver across a session
 * rather than per stint alone.
 */
model Stint {
  id             String    @id @default(cuid())
  registrationId String
  /// Null once a driver is removed from the line-up; the stint still counts.
  lineupDriverId String?
  sessionId      String?
  startedAt      DateTime
  endedAt        DateTime?
  /// Laps completed in this stint, when the team tracks them.
  laps           Int?
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  registration EventRegistration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  lineupDriver RegistrationDriver? @relation(fields: [lineupDriverId], references: [id], onDelete: SetNull)
  session      EventSession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([registrationId, startedAt])
  @@index([lineupDriverId])
  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// Event schedule (multi-day running order) & live timing
// ---------------------------------------------------------------------------

enum SessionType {
  PRACTICE
  QUALIFYING
  RACE
  WARMUP
  SCRUTINEERING
  DRIVER_BRIEFING
  MEDIA
  SUPPORT
  OTHER
}

enum SessionStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELED
}

enum FlagState {
  NONE
  GREEN
  YELLOW
  SAFETY_CAR
  VIRTUAL_SAFETY_CAR
  RED
  CHECKERED
}

/**
 * One item in an event's running order. Real-world weekends span several days
 * (scrutineering Friday, practice/qualifying Saturday, race Sunday), so
 * sessions carry their own start/end and are grouped by day in the UI.
 */
model EventSession {
  id        String        @id @default(cuid())
  eventId   String
  type      SessionType
  name      String
  startsAt  DateTime
  endsAt    DateTime
  location  String?
  notes     String?       @db.Text
  status    SessionStatus @default(SCHEDULED)
  flagState FlagState     @default(NONE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  event         RaceEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  timingEntries TimingEntry[]
  stints        Stint[]
  incidents     Incident[]
  conditions    SessionCondition[]
  logEntries    OfficialLogEntry[]
  garageFiles   GarageFile[]
  pitStops      PitStopPlan[]

  @@index([eventId, startsAt])
}

enum TimingStatus {
  RUNNING
  PIT
  OUT
  STOPPED
  FINISHED
  DNS
}

/**
 * Live timing row for one entry in one session.
 */
model TimingEntry {
  id             String       @id @default(cuid())
  sessionId      String
  registrationId String
  position       Int?
  lapsCompleted  Int          @default(0)
  /// Milliseconds — formatted for display client-side.
  lastLapMs      Int?
  bestLapMs      Int?
  /// Gap to the leader in milliseconds; null for the leader.
  gapMs          Int?
  status         TimingStatus @default(RUNNING)
  updatedAt      DateTime     @updatedAt

  session      EventSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([sessionId, registrationId])
  @@index([sessionId, position])
}

// ---------------------------------------------------------------------------
// Documents, announcements & community content
// ---------------------------------------------------------------------------

enum DocumentType {
  RULEBOOK
  SUPPLEMENTARY_REGS
  TECH_SHEET
  BULLETIN
  ENTRY_LIST
  SCHEDULE
  APPROVED_MEDIA
  OTHER
}

enum DocumentVisibility {
  PUBLIC
  COMPETITORS
  ORGANIZERS
}

/**
 * Regulations, technical sheets, race-control bulletins and approved media
 * kits. Attached to a series (season-long) or a single event.
 */
model RaceDocument {
  id           String             @id @default(cuid())
  seriesId     String?
  eventId      String?
  uploadedById String
  type         DocumentType
  title        String
  description  String?            @db.Text
  fileUrl      String
  /// Free-text revision label, e.g. "v2.1" or "Issue 3".
  version      String?
  visibility   DocumentVisibility @default(PUBLIC)
  /// Set when a newer revision replaces this one.
  supersededAt DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  series     Series?    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  event      RaceEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([seriesId, type])
  @@index([eventId, type])
}

enum AnnouncementUrgency {
  INFO
  IMPORTANT
  URGENT
}

/**
 * Notices from organizers to competitors — paddock notes, schedule changes.
 */
model Announcement {
  id        String              @id @default(cuid())
  seriesId  String?
  eventId   String?
  authorId  String
  title     String
  body      String              @db.Text
  urgency   AnnouncementUrgency @default(INFO)
  pinned    Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  series Series?    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  event  RaceEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([seriesId, createdAt])
  @@index([eventId, createdAt])
}

/**
 * Chat, scoped to exactly one room: an event's paddock during a race weekend,
 * or a team's own private channel. The "exactly one of" rule is enforced in
 * the router, the same way media and document scopes are.
 */
/**
 * One message, in exactly one room. A CHECK enforces the "exactly one".
 *
 * Four scopes rather than one polymorphic room id, because the access rule is
 * genuinely different in each and a single nullable `roomId` would make the
 * authorization code guess which. `eventId` and `teamId` are the original
 * whole-paddock and whole-roster rooms; `channelId` is a department room
 * inside one of those scopes; `threadId` is a private conversation between
 * people and belongs to no team or event at all.
 */
model ChatMessage {
  id        String   @id @default(cuid())
  eventId   String?
  teamId    String?
  channelId String?
  threadId  String?
  userId    String
  body      String   @db.Text
  createdAt DateTime @default(now())

  event   RaceEvent?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team    Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  channel ChatChannel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  thread  DirectThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([teamId, createdAt])
  @@index([channelId, createdAt])
  @@index([threadId, createdAt])
}

// ---------------------------------------------------------------------------
// Entry eligibility
// ---------------------------------------------------------------------------

enum RequirementKind {
  /// A credential of a given kind must exist, e.g. an FIA licence.
  CREDENTIAL
  /// A sim rating floor, e.g. iRating >= 2000 on a named platform.
  SIM_RATING
  /// Minimum age in years at the event date.
  MIN_AGE
  /// A briefing, medical or induction the organizer signs off manually.
  ACKNOWLEDGEMENT
}

enum RequirementEnforcement {
  /// Blocks confirmation until it is satisfied or waived.
  BLOCKING
  /// Recorded and shown, but never stops an entry.
  ADVISORY
}

/**
 * Something a driver must satisfy to enter.
 * Scoped to a series, or narrowed to one class — a fast class routinely
 * demands a higher licence than the novice class in the same championship.
 * Every requirement is checked against each declared driver on an entry, not
 * against the entrant, because it is the people in the car who need licences.
 */
model EntryRequirement {
  id             String                 @id @default(cuid())
  seriesId       String
  /// Null applies the requirement to every class in the series.
  seriesClassId  String?
  kind           RequirementKind
  label          String
  description    String?                @db.Text
  enforcement    RequirementEnforcement @default(BLOCKING)
  /// CREDENTIAL: the credential kind that must be present.
  credentialKind String?
  /// SIM_RATING: platform key within Profile.simStats, e.g. "iracing".
  simPlatform    String?
  /// SIM_RATING: the minimum iRating (or equivalent) required.
  minRating      Int?
  /// MIN_AGE: years.
  minAge         Int?
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  series     Series              @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  exemptions RequirementWaiver[]

  @@index([seriesId, active])
  @@index([seriesClassId])
}

/**
 * An organizer's decision on one requirement for one driver on one entry:
 * either a manual sign-off (a briefing attended) or a waiver granted.
 */
model RequirementWaiver {
  id             String   @id @default(cuid())
  requirementId  String
  registrationId String
  /// The driver the decision is about.
  userId         String
  /// True when the requirement is satisfied; false records an explicit refusal.
  granted        Boolean  @default(true)
  reason         String?  @db.Text
  decidedById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  requirement  EntryRequirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user         User              @relation("WaiverSubject", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy    User              @relation("WaiverDecider", fields: [decidedById], references: [id], onDelete: Cascade)

  @@unique([requirementId, registrationId, userId])
  @@index([registrationId])
}

// ---------------------------------------------------------------------------
// Scrutineering & technical compliance
// ---------------------------------------------------------------------------

enum InspectionStage {
  /// Before the car runs.
  PRE_EVENT
  /// Between sessions, e.g. after qualifying.
  IN_EVENT
  /// Post-race impound / teardown.
  POST_RACE
}

enum InspectionStatus {
  NOT_STARTED
  IN_PROGRESS
  PASSED
  /// Failed with work to do; a re-inspection is expected.
  FAILED
  /// Failed and referred to the stewards.
  REFERRED
}

enum CheckResult {
  PENDING
  PASS
  FAIL
  /// Checked and deliberately not applicable to this car.
  NOT_APPLICABLE
}

/**
 * A reusable list of checks a scrutineer works through.
 * Templates belong to a series so a club can write its own card once and use
 * it every round, optionally narrowed to one class where the technical
 * regulations differ.
 */
model InspectionTemplate {
  id            String          @id @default(cuid())
  seriesId      String
  seriesClassId String?
  name          String
  stage         InspectionStage @default(PRE_EVENT)
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  series      Series                   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  items       InspectionTemplateItem[]
  inspections Inspection[]

  @@index([seriesId, active])
}

model InspectionTemplateItem {
  id          String  @id @default(cuid())
  templateId  String
  label       String
  /// Regulation article the check enforces.
  regulation  String?
  /// What to record, e.g. "kg", "mm". Null for a plain pass/fail.
  measureUnit String?
  /// Inclusive bounds for a measured value.
  minValue    Float?
  maxValue    Float?
  sortOrder   Int     @default(0)

  template InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  checks   InspectionCheck[]

  @@index([templateId, sortOrder])
}

/**
 * One car's trip through the scrutineering bay.
 */
model Inspection {
  id             String           @id @default(cuid())
  registrationId String
  templateId     String?
  stage          InspectionStage  @default(PRE_EVENT)
  status         InspectionStatus @default(NOT_STARTED)
  /// Set when this is a re-check after a failure.
  supersedesId   String?          @unique
  inspectedById  String
  notes          String?          @db.Text
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  registration EventRegistration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  template     InspectionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  inspectedBy  User                @relation(fields: [inspectedById], references: [id], onDelete: Cascade)
  supersedes   Inspection?         @relation("InspectionRecheck", fields: [supersedesId], references: [id], onDelete: SetNull)
  recheck      Inspection?         @relation("InspectionRecheck")
  checks       InspectionCheck[]

  @@index([registrationId, stage])
}

model InspectionCheck {
  id             String      @id @default(cuid())
  inspectionId   String
  templateItemId String?
  /// Copied from the template so the record survives a template edit.
  label          String
  regulation     String?
  measureUnit    String?
  minValue       Float?
  maxValue       Float?
  result         CheckResult @default(PENDING)
  /// The value actually measured, where the check takes one.
  measuredValue  Float?
  notes          String?     @db.Text
  sortOrder      Int         @default(0)

  inspection   Inspection              @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  templateItem InspectionTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)

  @@index([inspectionId, sortOrder])
}

// ---------------------------------------------------------------------------
// Incidents, protests & the stewards' queue
// ---------------------------------------------------------------------------

enum IncidentSource {
  /// Raised by a competitor about someone else, or about themselves.
  COMPETITOR
  /// From a marshal post or another trackside official.
  MARSHAL
  /// Race control's own observation.
  RACE_CONTROL
  /// A formal protest, which carries a fee and a right of reply.
  PROTEST
}

enum IncidentStatus {
  /// Filed, not yet looked at.
  REPORTED
  /// Race control has seen it and is leaving it on the table.
  NOTED
  UNDER_INVESTIGATION
  /// Looked at and closed without action.
  NO_FURTHER_ACTION
  /// Closed by issuing a penalty.
  PENALTY_ISSUED
  /// Withdrawn by whoever filed it.
  WITHDRAWN
}

/**
 * An incident report: the input to stewarding.
 * Penalties used to appear from nowhere. Real stewarding starts here — a
 * competitor, a marshal post or race control reports what happened, with a lap
 * and a corner, and the queue is triaged from noted through to a decision.
 */
model Incident {
  id                       String         @id @default(cuid())
  eventId                  String
  sessionId                String?
  source                   IncidentSource @default(COMPETITOR)
  status                   IncidentStatus @default(REPORTED)
  /// The entry the report is about.
  subjectRegistrationId    String?
  /// The entry that filed it, when a competitor did.
  reportedByRegistrationId String?
  reportedById             String
  summary                  String
  description              String?        @db.Text
  lapNumber                Int?
  /// Free text: "Turn 5", "pit exit", "flag point 12".
  location                 String?
  /// The named corner, when the event runs a track layout with turns defined.
  turnId                   String?
  occurredAt               DateTime?
  /// Race control's reasoning when the report is closed.
  decisionNotes            String?        @db.Text
  decidedById              String?
  decidedAt                DateTime?
  /// The penalty this report produced, when it produced one.
  penaltyId                String?        @unique
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  event           RaceEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session         EventSession?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  subject         EventRegistration? @relation("IncidentSubject", fields: [subjectRegistrationId], references: [id], onDelete: SetNull)
  reportedByEntry EventRegistration? @relation("IncidentReporter", fields: [reportedByRegistrationId], references: [id], onDelete: SetNull)
  reportedBy      User               @relation("IncidentReportedBy", fields: [reportedById], references: [id], onDelete: Cascade)
  decidedBy       User?              @relation("IncidentDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  penalty         Penalty?           @relation(fields: [penaltyId], references: [id], onDelete: SetNull)
  turn            TrackTurn?         @relation(fields: [turnId], references: [id], onDelete: SetNull)
  media           Media[]
  responses       IncidentResponse[]
  logEntries      OfficialLogEntry[]

  @@index([eventId, status])
  @@index([subjectRegistrationId])
  @@index([turnId])
}

/**
 * A reply on an incident — the right of response a protest carries, and the
 * back-and-forth race control records while investigating.
 */
model IncidentResponse {
  id                   String   @id @default(cuid())
  incidentId           String
  authorId             String
  body                 String   @db.Text
  /// Visible to the competitors involved as well as to officials.
  visibleToCompetitors Boolean  @default(true)
  createdAt            DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

enum ResultStatus {
  FINISHED
  DNF
  DNS
  DSQ
}

/**
 * Classified finish for one entry. Drives series standings.
 */
model EventResult {
  id             String       @id @default(cuid())
  eventId        String
  registrationId String       @unique
  finishPosition Int?
  status         ResultStatus @default(FINISHED)
  lapsCompleted  Int?
  fastestLap     Boolean      @default(false)
  /// Manual override; when null, points come from the series points scheme.
  pointsOverride Int?
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  event        RaceEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

enum PenaltyType {
  TIME_PENALTY
  DRIVE_THROUGH
  STOP_GO
  GRID_DROP
  POINTS_DEDUCTION
  DISQUALIFICATION
  WARNING
  FINE
}

enum PenaltyStatus {
  ISSUED
  UNDER_APPEAL
  UPHELD
  REDUCED
  OVERTURNED
}

/**
 * A penalty issued by race control against an entry. Public by design:
 * penalties surface on the competitor's series profile.
 */
model Penalty {
  id             String        @id @default(cuid())
  eventId        String
  registrationId String
  issuedById     String
  type           PenaltyType
  status         PenaltyStatus @default(ISSUED)
  summary        String
  details        String?       @db.Text
  /// Regulation or article the decision cites.
  regulation     String?
  lapNumber      Int?

  // Magnitudes — only the field matching `type` is meaningful.
  timeSeconds    Int?
  gridPlaces     Int?
  /// Championship points removed; feeds standings while the penalty stands.
  pointsDeducted Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event        RaceEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration EventRegistration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  issuedBy     User               @relation("PenaltyIssuer", fields: [issuedById], references: [id], onDelete: Cascade)
  appeal       PenaltyAppeal?
  media        Media[]
  incident     Incident?
  logEntries   OfficialLogEntry[]

  @@index([eventId])
  @@index([registrationId])
  @@index([status])
}

enum AppealStatus {
  SUBMITTED
  UNDER_REVIEW
  UPHELD
  REJECTED
}

/**
 * A competitor's challenge to a penalty. One appeal per penalty.
 */
model PenaltyAppeal {
  id          String       @id @default(cuid())
  penaltyId   String       @unique
  filedById   String
  statement   String       @db.Text
  status      AppealStatus @default(SUBMITTED)
  decision    String?      @db.Text
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  penalty   Penalty @relation(fields: [penaltyId], references: [id], onDelete: Cascade)
  filedBy   User    @relation("AppealFiler", fields: [filedById], references: [id], onDelete: Cascade)
  decidedBy User?   @relation("AppealDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  media     Media[]

  @@index([filedById])
  @@index([status])
}

enum VolunteerRoleType {
  MARSHAL
  FLAG
  TIMING
  SCRUTINEER
  MEDICAL
  GRID
  PIT_LANE
  MEDIA
  OTHER
}

model VolunteerShift {
  id       String            @id @default(cuid())
  eventId  String
  role     VolunteerRoleType
  title    String
  startsAt DateTime
  endsAt   DateTime
  /// Number of volunteers needed; overflow signups are waitlisted.
  capacity Int
  notes    String?           @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   RaceEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  signups VolunteerSignup[]

  @@index([eventId, startsAt])
}

enum VolunteerSignupStatus {
  SIGNED_UP
  WAITLISTED
  CONFIRMED
  CANCELED
}

model VolunteerSignup {
  id        String                @id @default(cuid())
  shiftId   String
  userId    String
  status    VolunteerSignupStatus @default(SIGNED_UP)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  shift VolunteerShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId])
  @@index([userId])
  @@index([shiftId, status])
}

model RaceEntry {
  id       String  @id @default(cuid())
  eventId  String
  userId   String
  carClass String?
  result   Json?

  event RaceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model RaceReport {
  id        String   @id @default(cuid())
  authorId  String
  eventId   String?
  title     String
  body      String   @db.Text
  tags      String[]
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author           User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  event            RaceEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  mediaAttachments Media[]

  @@index([authorId])
  @@index([tags])
  @@index([published, createdAt])
}

model StrategyPlan {
  id      String  @id @default(cuid())
  eventId String
  /// Author — always set; plans are private to the author unless shared.
  ownerId String
  /// When set, every active member of this team can read the plan.
  teamId  String?

  name           String
  stintPlan      Json?
  fuelStrategy   Json?
  driverRotation Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event RaceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  owner User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  team  Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([ownerId])
  @@index([teamId])
}

// ---------------------------------------------------------------------------
// Social
// ---------------------------------------------------------------------------

enum EndorsementCategory {
  RACECRAFT
  ENGINEERING
  TEAMWORK
  STRATEGY
  PROFESSIONALISM
  SPONSORSHIP_VALUE
}

model Endorsement {
  id         String              @id @default(cuid())
  fromUserId String
  toUserId   String
  note       String?             @db.Text
  category   EndorsementCategory
  createdAt  DateTime            @default(now())

  fromUser User @relation("EndorsementFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("EndorsementTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId, category])
  @@index([toUserId])
}

// ---------------------------------------------------------------------------
// Tracks, layouts & turns
// ---------------------------------------------------------------------------

/**
 * How a track is surfaced. Sim circuits and real circuits sit side by side —
 * a series that runs both wants the same Spa in both worlds, distinguished
 * only by which platform the layout is driven on.
 */
enum TrackKind {
  /// A real facility. Sim versions of it are layouts on the same track.
  CIRCUIT
  /// A temporary street course.
  STREET
  RALLY_STAGE
  OVAL
  KART
  AUTOCROSS
  /// Somewhere with no permanent geometry — an airfield day, a hillclimb.
  OTHER
}

/**
 * Which way round a layout is driven; both are raced at some venues.
 */
enum TrackDirection {
  CLOCKWISE
  ANTICLOCKWISE
}

/**
 * A venue.
 * `RaceEvent.venue` is free text and always will be for one-off bookings, but
 * a track record, a garage allocation or "every incident at this corner" all
 * need the circuit to be one row rather than four spellings of it. Tracks are
 * shared reference data: anyone signed in may add one, and the person who
 * added it curates it. There is no platform-admin role to appeal to, so a
 * track that is referenced by an event cannot be deleted.
 */
model Track {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  kind         TrackKind @default(CIRCUIT)
  /// ISO 3166-1 alpha-2 where there is one; null for a sim-only venue.
  country      String?
  region       String?
  city         String?
  /// Street address of the paddock gate, for the people driving a transporter.
  addressLine  String?
  postalCode   String?
  /**
   * Decimal degrees, WGS 84. Kept as a pair of nullable floats rather than
   * PostGIS: the only questions asked of it are "put a pin here" and "how far
   * is this from me", and a geography column would make every deployment need
   * an extension for that.
   */
  latitude     Float?
  longitude    Float?
  timezone     String?
  websiteUrl   String?
  /**
   * Sanctioning grade, kept free-form: "FIA Grade 2", "NASA Region",
   * "Club" and a governing body nobody outside one country has heard of are
   * all legitimate. Enumerating them would exclude grassroots venues.
   */
  licenceGrade String?
  /// Permanent garages/pit boxes at the facility, for allocation.
  pitBoxCount  Int?
  /// Permanent garage buildings, where the facility has them.
  garageCount  Int?
  notes        String?   @db.Text
  /**
   * Canonical venue shipped with the platform rather than added by a user.
   * Reference tracks have no creator, so the "only the person who added it
   * may edit it" rule would lock them permanently — a typo in a seeded track
   * could never be fixed by anyone. Instead they are open to correction by
   * anyone signed in, with every change audited, and cannot be deleted.
   */
  isReference  Boolean   @default(false)
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy User?         @relation("TrackCreator", fields: [createdById], references: [id], onDelete: SetNull)
  layouts   TrackLayout[]
  rules     TrackRule[]
  images    TrackImage[]

  @@index([country, name])
  @@index([kind])
}

/**
 * What a facility restricts, as distinct from what a series regulates.
 *
 * A club can write its own sporting regulations but cannot negotiate away the
 * county ordinance that caps noise at 90 dBA, and a driver turned away at
 * scrutineering for a loud exhaust is not helped by the series rule book. The
 * kinds here are the ones that actually stop someone running.
 */
enum TrackRuleKind {
  /// Noise limit, how it is measured, and any louder days.
  SOUND
  /// Running hours, quiet days, days of use permitted per year.
  CURFEW
  /// Competition licence required, novice restrictions, minimum age.
  LICENCE
  /// Safety equipment the facility mandates beyond the series regulations.
  SAFETY
  /// Camping, generators, open flame, awnings, tyre storage.
  PADDOCK
  /// Fuel handling, spill kits, tyre and fluid disposal.
  ENVIRONMENTAL
  /// Gate times, minors, animals, spectator areas.
  ACCESS
  OTHER
}

/**
 * One rule or ordinance a facility operates under.
 *
 * Sourced rather than asserted: `source` and `sourceUrl` exist because "90
 * dBA" from an anonymous edit is worth nothing to a competitor deciding
 * whether to fit a quieter exhaust, and `verifiedOn` exists because facility
 * rules change between seasons — a stale sound limit is worse than a missing
 * one, so the page can show its age and let people judge.
 */
model TrackRule {
  id         String        @id @default(cuid())
  trackId    String
  kind       TrackRuleKind
  /// The rule in one line: "90 dBA, measured at 50 ft".
  title      String
  /// The detail a competitor needs before they load the trailer.
  detail     String?       @db.Text
  /// Citation in words: "Monterey County use permit", "Salisbury CT ordinance".
  source     String?
  sourceUrl  String?
  /// When somebody last checked this against the facility. Null = never.
  verifiedOn DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId, kind])
}

/**
 * Plan shape of an oval, precise enough to draw and no more.
 *
 * Only shapes whose outline follows from figures we actually hold are listed.
 * There is no ROAD member on purpose: a road course's outline is survey data,
 * not something derivable from its length and turn count, so those get a real
 * uploaded map or nothing at all.
 */
enum LayoutShape {
  /// Symmetric four-turn oval; the default bullring or superspeedway.
  OVAL
  /// One straight bulges outward into a shallow third bend — Talladega.
  TRI_OVAL
  /// The front straight bends twice — Texas, Atlanta.
  QUAD_OVAL
  /// Long straights, tight hairpins at each end — Martinsville.
  PAPERCLIP
  /// One end noticeably wider than the other — Michigan, Richmond.
  D_SHAPE
  /// Three straights, three corners — Pocono.
  TRIANGLE
  /// Four long straights joined by short corners — Indianapolis.
  RECTANGLE
}

/**
 * One configuration of a track. Spa runs a Grand Prix layout and an Endurance
 * layout; a club circuit might run "Full", "Short" and "Short reversed".
 * Results, records and turn references all hang off the layout rather than the
 * track, because a lap time on one layout means nothing on another.
 */
model TrackLayout {
  id              String         @id @default(cuid())
  trackId         String
  name            String
  /// Null for a real-world layout; the sim it belongs to otherwise.
  platform        String?
  lengthMeters    Int?
  direction       TrackDirection @default(CLOCKWISE)
  /// Elevation change over a lap, where the venue publishes it.
  elevationMeters Int?
  /**
   * How many corners the layout has, as the circuit counts them.
   *
   * Deliberately not `turns.length`: the headline number is known for every
   * circuit ("14 turns"), whereas the `turns` relation only fills up once
   * somebody types in the corner names, and most never will. Storing the count
   * separately means a layout can say "14 turns" on day one and still gain
   * named corners later.
   */
  turnCount       Int?
  /**
   * Rough plan shape, used to draw a schematic where no map has been
   * uploaded. Null for anything whose shape is not derivable from figures —
   * which is every road course, because drawing a plausible squiggle and
   * labelling it with a real circuit's name would be inventing a map.
   */
  shape           LayoutShape?
  /// Banking through the turns, degrees. Feeds the schematic and reads well.
  bankingDegrees  Int?
  /// The layout an event defaults to when none is chosen.
  isPrimary       Boolean        @default(false)
  active          Boolean        @default(true)
  notes           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  track       Track         @relation(fields: [trackId], references: [id], onDelete: Cascade)
  turns       TrackTurn[]
  sectors     TrackSector[]
  events      RaceEvent[]
  images      TrackImage[]
  garageFiles GarageFile[]

  @@unique([trackId, name])
  @@index([trackId, isPrimary])
}

/**
 * What a picture of a circuit is showing.
 *
 * Worth distinguishing because they answer different questions and are wanted
 * at different moments: a driver studying a layout wants the map, a crew chief
 * arriving on Thursday wants the paddock plan, and neither is served by
 * scrolling a mixed gallery to find it.
 */
enum TrackImageKind {
  /// The circuit's own layout diagram — corner numbers, pit entry, sectors.
  MAP
  /// Photographed from above; shows elevation and run-off a diagram flattens.
  AERIAL
  /// Facility plan: paddock, garages, gates, scrutineering bay, camping.
  PADDOCK
  /// A corner, the pit lane, the grid. Everything else.
  PHOTO
}

/**
 * A photograph or diagram of a track.
 *
 * A gallery rather than one slot per layout, because a venue genuinely has
 * several pictures worth keeping and they are not interchangeable: the
 * official map, an aerial that shows the elevation the map flattens, and the
 * paddock plan that tells a transporter which gate to use.
 *
 * `layoutId` is nullable and that nullability is the design: a paddock plan
 * and a site photograph belong to the facility, not to one configuration,
 * whereas a layout map is meaningless detached from the layout it draws.
 *
 * `credit` is not decoration. Most circuit maps belong to the circuit, and a
 * platform that hosts them without a visible attribution is a platform whose
 * users are quietly republishing someone else's work.
 */
model TrackImage {
  id           String         @id @default(cuid())
  trackId      String
  /// Null when the image is about the whole facility rather than one layout.
  layoutId     String?
  kind         TrackImageKind @default(MAP)
  url          String
  caption      String?
  /// Whose image this is: "Circuit of the Americas", "Jane Doe / CC BY-SA".
  credit       String?
  /// Manual order within a track. The first MAP is what the cards show.
  position     Int            @default(0)
  /// Who added it, for the audit trail. Null once that account is deleted.
  uploadedById String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  track      Track        @relation(fields: [trackId], references: [id], onDelete: Cascade)
  layout     TrackLayout? @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  uploadedBy User?        @relation("TrackImageUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([trackId, position])
  @@index([layoutId, position])
}

/**
 * A named corner. Marshals report "Eau Rouge", not "the sixth corner", and a
 * steward reading a report an hour later needs both. Sector is stored so an
 * incident can be tied back to the timing sector it happened in.
 */
model TrackTurn {
  id          String  @id @default(cuid())
  layoutId    String
  /// Turn number as the circuit numbers them; ordering key for the lap.
  number      Int
  /// "Eau Rouge", "The Corkscrew". Null where the corner is just a number.
  name        String?
  /// Which timing sector the turn falls in, where sectors are defined.
  sector      Int?
  /// Marshal post or flag point covering this turn.
  marshalPost String?
  notes       String? @db.Text

  layout    TrackLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  incidents Incident[]

  @@unique([layoutId, number])
  @@index([layoutId, sector])
}

/**
 * A timing sector on a layout. Most circuits run three; some run more.
 */
model TrackSector {
  id           String  @id @default(cuid())
  layoutId     String
  number       Int
  name         String?
  lengthMeters Int?

  layout TrackLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@unique([layoutId, number])
}

// ---------------------------------------------------------------------------
// Session conditions
// ---------------------------------------------------------------------------

/**
 * The state of the racing surface. Distinct from the weather: a track can be
 * damp under a clear sky an hour after rain, which is exactly the situation
 * tire regulations care about.
 */
enum TrackState {
  DRY
  DAMP
  WET
  STANDING_WATER
  /// Winter club events and rally stages are run on it; ignoring it is worse.
  SNOW_ICE
}

enum WeatherKind {
  CLEAR
  CLOUDY
  OVERCAST
  LIGHT_RAIN
  HEAVY_RAIN
  FOG
  SNOW
  WINDY
}

/**
 * Conditions logged during a session.
 * A time series rather than a single field on the session: a two-hour race
 * that starts dry and ends in standing water is the normal case, and a
 * strategy review a week later needs to know when it turned. The most recent
 * reading is the session's current state.
 */
model SessionCondition {
  id            String       @id @default(cuid())
  sessionId     String
  recordedAt    DateTime     @default(now())
  recordedById  String?
  trackState    TrackState
  weather       WeatherKind?
  /// Degrees Celsius. Air and track diverge by 20°C on a summer afternoon.
  airTempC      Float?
  trackTempC    Float?
  humidityPct   Int?
  windKph       Float?
  /// Compass point or bearing as the timing crew records it: "NW", "290".
  windDirection String?
  notes         String?      @db.Text

  session    EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  recordedBy User?        @relation("ConditionRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([sessionId, recordedAt])
}

// ---------------------------------------------------------------------------
// Cars, transponders & tires
// ---------------------------------------------------------------------------

/**
 * A car.
 * Results follow the entry today, which loses the fact that the same chassis
 * raced under three team names over five seasons — the thing a homologation
 * check, a build history and a "cars that have raced here" list all need. A
 * car belongs to a team or to a person; exactly one, enforced by a CHECK.
 */
model Car {
  id            String  @id @default(cuid())
  teamId        String?
  ownerUserId   String?
  /// What the crew calls it: "Car 7", "the red one", "Chassis 004".
  name          String
  make          String?
  model         String?
  year          Int?
  /// Chassis plate / VIN. Unique per car in practice, but not enforced —
  /// grassroots cars are frequently unplated and sims have none at all.
  chassisNumber String?
  engine        String?
  /// Homologation or logbook number, where the sanctioning body issues one.
  homologation  String?
  /// Free-form class the car is built to, independent of any series' classes.
  classLabel    String?
  liveryUrl     String?
  /**
   * Running hours on the car. Optional and team-maintained — most club cars
   * have no hour meter — but it is what a service interval quoted in hours has
   * to be measured against, so a team that tracks it can be told a rebuild is
   * due before the rebuild tells them.
   */
  runningHours  Float?
  notes         String? @db.Text
  /// Retired cars stay for the history but drop out of the entry picker.
  active        Boolean @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team          Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  ownerUser     User?               @relation("CarOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdBy     User?               @relation("CarCreator", fields: [createdById], references: [id], onDelete: SetNull)
  registrations EventRegistration[]
  inventory     InventoryItem[]
  garageFiles   GarageFile[]
  services      CarService[]

  @@index([teamId, active])
  @@index([ownerUserId, active])
}

/**
 * A timing transponder.
 * Live timing is matched by registration in RaceOps, but every real timing
 * system keys on a transponder number. Holding the number as a record — with
 * whoever owns it, since series commonly rent them out for a weekend — is what
 * lets a timing feed be reconciled to entries without a spreadsheet.
 */
model Transponder {
  id          String  @id @default(cuid())
  /// The number printed on the unit. Globally unique by manufacturer.
  number      String  @unique
  /// "MyLaps X2", "AMB TranX260", "RMonitor" — kept free-form.
  make        String?
  teamId      String?
  ownerUserId String?
  /// Set when a series owns a pool it rents to entrants for the weekend.
  seriesId    String?
  active      Boolean @default(true)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team        Team?                   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  ownerUser   User?                   @relation("TransponderOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  series      Series?                 @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  assignments TransponderAssignment[]

  @@index([teamId])
  @@index([seriesId])
}

/**
 * A transponder fitted to an entry for one event.
 * Per event rather than per car: rented units move between entries week to
 * week, and an endurance entry commonly carries a backup alongside the primary
 * in case the first fails mid-race.
 */
model TransponderAssignment {
  id             String   @id @default(cuid())
  registrationId String
  transponderId  String
  /// The unit the timing feed is expected to see. At most one per entry.
  isPrimary      Boolean  @default(true)
  assignedAt     DateTime @default(now())
  notes          String?

  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  transponder  Transponder       @relation(fields: [transponderId], references: [id], onDelete: Cascade)

  @@unique([registrationId, transponderId])
  @@index([transponderId])
}

enum TireSetStatus {
  /// Issued to the entry and marked, not yet on the car.
  ALLOCATED
  FITTED
  /// Handed back — a set that came off the car and may go on again.
  RETURNED
  /// Scrubbed from the allocation: mis-scanned, damaged before use, replaced.
  VOID
}

/**
 * One set of tires allocated to an entry for an event.
 * A hard regulation in most series and one of the few that is genuinely
 * countable, which is why it is worth holding as records rather than a number
 * on a clipboard. `identifier` is whatever the scrutineers mark or scan.
 */
model TireSet {
  id             String        @id @default(cuid())
  eventId        String
  registrationId String
  /// Barcode, etch mark or hand-written set number — whatever was used.
  identifier     String
  /// Compound as the regulations name it: "Medium", "S9", "Wet".
  compound       String?
  /// Size/spec where a series controls it, e.g. "305/680R18".
  dimension      String?
  status         TireSetStatus @default(ALLOCATED)
  allocatedAt    DateTime      @default(now())
  allocatedById  String?
  notes          String?

  event        RaceEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  allocatedBy  User?             @relation("TireAllocator", fields: [allocatedById], references: [id], onDelete: SetNull)
  pitStops     PitStopPlan[]

  @@unique([eventId, identifier])
  @@index([registrationId, status])
}

// ---------------------------------------------------------------------------
// Paddock allocation & credentials
// ---------------------------------------------------------------------------

/**
 * Where an entry is put for a meeting.
 * Pure spreadsheet work today, and the spreadsheet is the thing every team
 * asks for on the Thursday. Garage, pit box and paddock space are separate
 * fields because they are separate places: a club meeting allocates paddock
 * space and no garages, a pro round allocates all three.
 */
model PaddockAllocation {
  id             String  @id @default(cuid())
  eventId        String
  registrationId String  @unique
  /// Garage or awning label as the circuit names it: "Garage 12", "Bay B4".
  garage         String?
  /// Pit box number, where pit lane is allocated separately from garages.
  pitBox         String?
  /// Paddock space for the transporter and awning: "P14", "Row 3 East".
  paddockSpace   String?
  /// Space for the truck itself, where a circuit separates it out.
  transporterBay String?
  /// Mains hookup, where the circuit sells or allocates it.
  powerHookup    String?
  notes          String? @db.Text

  assignedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event        RaceEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  assignedBy   User?             @relation("PaddockAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([eventId])
}

/**
 * A category of pass an event issues, with how many each entry gets.
 * Free-form rather than an enum: what a club meeting calls a "working pass"
 * and what a pro round calls "paddock/pit lane/grid" have nothing in common.
 */
/**
 * An area a pass opens.
 *
 * Zones rather than a single numeric "level" because access is not a ladder:
 * a photographer belongs trackside and in the media centre but not in race
 * control, and a team owner is the other way round. A number would force one
 * of those to be "higher" than the other, and a marshal on a gate would have
 * to remember which.
 */
enum AccessZone {
  PADDOCK
  GARAGE
  PIT_LANE
  GRID
  /// Trackside during running — marshal posts, photographer holes.
  TRACKSIDE
  RACE_CONTROL
  MEDIA_CENTRE
  SCRUTINEERING
  HOSPITALITY
}

/**
 * Who a pass type is generated for when credentials are swept for an event.
 *
 * Set on the type rather than chosen at generation time, so "generate the
 * credentials" is one button that does the same thing every time rather than a
 * form somebody fills in differently each round.
 */
enum CredentialAudience {
  /// Everyone named in a confirmed entry's driver line-up.
  DRIVER
  /// The person or team that entered, where they are not already a driver.
  ENTRANT
  /// Anyone signed up to a volunteer shift at this event.
  VOLUNTEER
  /// Series organizers and anyone holding a staff role.
  ORGANIZER
}

model CredentialType {
  id                String  @id @default(cuid())
  eventId           String
  name              String
  description       String?
  /// Passes of this type each entry gets before asking for more.
  allowancePerEntry Int     @default(0)
  /// Total the event has to give out; null when there is no hard cap.
  totalAvailable    Int?
  /// Display order on the collection sheet.
  sortOrder         Int     @default(0)
  /// Areas this pass opens. Empty means the pass says nothing about access.
  zones             AccessZone[]
  /// Whose passes are created by the generator. Null excludes it entirely.
  autoIssueTo       CredentialAudience?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event       RaceEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  credentials Credential[]

  @@unique([eventId, name])
}

enum CredentialStatus {
  /// Requested by the entry, not yet approved.
  REQUESTED
  /// Approved and waiting at accreditation.
  ISSUED
  /// Physically handed over.
  COLLECTED
  /// Cancelled, lost or withdrawn. Kept so the count can be audited.
  VOID
}

/**
 * One pass, issued to a named person.
 * Named rather than a bare count because that is what accreditation actually
 * needs at the gate, and what an insurer asks for after an incident. The
 * holder need not have a RaceOps account — a mechanic's mother-in-law helping
 * for the weekend is a normal credential.
 */
model Credential {
  id               String           @id @default(cuid())
  eventId          String
  credentialTypeId String
  /// The entry it counts against; null for officials, media and staff passes.
  registrationId   String?
  holderName       String
  /// Set when the holder has an account, for their own pass list.
  holderUserId     String?
  /// Role printed on the pass: "Mechanic", "Team guest", "Photographer".
  holderRole       String?
  /// Serial or barcode printed on the pass.
  serial           String?
  /**
   * What the QR code on the pass encodes.
   *
   * Unguessable and separate from the row id: the id turns up in URLs and in
   * organizer tooling, and a pass whose code could be derived from it would be
   * forgeable by anyone who had seen one. Rotating this invalidates a lost
   * pass without disturbing its history.
   */
  qrToken          String?          @unique
  status           CredentialStatus @default(REQUESTED)
  issuedAt         DateTime?
  collectedAt      DateTime?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event          RaceEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scans          CredentialScan[]
  credentialType CredentialType     @relation(fields: [credentialTypeId], references: [id], onDelete: Cascade)
  registration   EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  holderUser     User?              @relation("CredentialHolder", fields: [holderUserId], references: [id], onDelete: SetNull)

  @@unique([eventId, serial])
  @@index([eventId, status])
  @@index([registrationId])
  @@index([holderUserId])
}

/**
 * What a gate decided about one scan.
 *
 * Four outcomes, not two, because "no" has three different causes and a
 * marshal has to do something different about each: send them to the right
 * gate, send them to accreditation, or call race control.
 */
enum ScanResult {
  /// Valid, and it opens the zone this gate is checking.
  ADMITTED
  /// A real, valid pass — for somewhere else. Point them at the right gate.
  WRONG_ZONE
  /// Cancelled, or issued but never approved. Accreditation problem.
  NOT_VALID
  /// The code matched no pass at all. Not one of ours.
  UNKNOWN
}

/**
 * One scan at a gate.
 *
 * Recorded for every scan including the refusals, because the refusals are the
 * ones anybody asks about afterwards: who was turned away, from where, and
 * whether the same unknown code was tried at four gates in a row. It is also
 * the only record of who was inside the fence when something happened, which
 * is the first thing an insurer asks for.
 *
 * `credentialId` is nullable — an unknown code has no pass to point at, and
 * dropping those scans would erase exactly the ones worth investigating. The
 * raw `token` is kept for the same reason.
 */
model CredentialScan {
  id           String      @id @default(cuid())
  eventId      String
  credentialId String?
  result       ScanResult
  /// The zone the gate was set to check. Null for a general identity check.
  zone         AccessZone?
  /// What the gate is called on the ground: "Paddock gate 2", "Pit lane in".
  gate         String?
  /// The scanned code. Kept even when it matched nothing.
  token        String?
  scannedById  String
  scannedAt    DateTime    @default(now())

  event      RaceEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  credential Credential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  scannedBy  User        @relation("CredentialScanner", fields: [scannedById], references: [id], onDelete: Cascade)

  @@index([eventId, scannedAt])
  @@index([credentialId])
  @@index([eventId, result])
}

// ---------------------------------------------------------------------------
// Officials' log & audit trail
// ---------------------------------------------------------------------------

/**
 * What kind of thing happened, for filtering and for the bulletin's headings.
 */
enum LogCategory {
  /// Session started, suspended, resumed, finished.
  SESSION
  /// Flag or safety-car state change.
  FLAG
  /// An incident was noted, investigated or decided.
  INCIDENT
  PENALTY
  /// Scrutineering: a car referred, passed or failed.
  TECHNICAL
  /// A document or bulletin was published.
  DOCUMENT
  /// Anything else race control wants on the record.
  NOTE
}

/**
 * The officials' event log: a timestamped, chronological record of everything
 * race control did.
 * Most of these events are already captured individually — a flag change is a
 * field on the session, a penalty is a row — but nobody can read them in
 * order, which is what an end-of-meeting bulletin is. Entries are written
 * automatically as things happen and by hand for anything the system cannot
 * see ("driver briefing held", "circuit inspected after rain").
 * Entries are append-only by design. An error is corrected by a later entry
 * saying so, exactly as a paper log is.
 */
model OfficialLogEntry {
  id         String      @id @default(cuid())
  eventId    String
  sessionId  String?
  category   LogCategory @default(NOTE)
  /// Wall-clock time of the thing itself, which may precede the write.
  occurredAt DateTime    @default(now())
  summary    String
  detail     String?     @db.Text
  /// Null for entries the system wrote itself.
  officialId String?
  /// Set when the entry was generated rather than typed.
  automatic  Boolean     @default(false)
  /// Officials-only until the bulletin is published.
  published  Boolean     @default(false)

  incidentId String?
  penaltyId  String?

  createdAt DateTime @default(now())

  event    RaceEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session  EventSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  official User?         @relation("LogOfficial", fields: [officialId], references: [id], onDelete: SetNull)
  incident Incident?     @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  penalty  Penalty?      @relation(fields: [penaltyId], references: [id], onDelete: SetNull)

  @@index([eventId, occurredAt])
  @@index([sessionId, occurredAt])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  /// A state transition worth naming separately from a field edit.
  STATUS_CHANGE
  PUBLISH
}

/**
 * Who changed what, and when.
 * Once a championship has consequences, someone will dispute a change, and
 * "the database says so now" is not an answer. Separate from the officials'
 * log on purpose: the log is a narrative officials write and publish, this is
 * a record the system keeps whether anyone wants it or not.
 * Never exposed for editing or deletion through any router.
 */
model AuditEvent {
  id         String      @id @default(cuid())
  /// Null when the actor is the system (a webhook, a scheduled job).
  actorId    String?
  action     AuditAction
  /// Prisma model name, e.g. "EventResult", "Penalty", "RaceDocument".
  entityType String
  entityId   String
  /// Scope, for "everything that happened at this event" queries.
  eventId    String?
  seriesId   String?
  /// One line a human can read without decoding the payload.
  summary    String
  /// Changed fields only: { field: { from, to } }. Null for creates/deletes.
  changes    Json?
  createdAt  DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([eventId, createdAt])
  @@index([seriesId, createdAt])
  @@index([actorId, createdAt])
}

// ---------------------------------------------------------------------------
// Waivers & e-signature
// ---------------------------------------------------------------------------

/**
 * Who a waiver applies to. Real-world motorsport requires signatures from
 * more than the drivers — a crew member in the pit lane and a guest in the
 * paddock are both on somebody's insurance.
 */
enum WaiverAudience {
  /// Everyone declared on an entry: drivers, crew, named pass holders.
  ALL_PARTICIPANTS
  DRIVERS
  CREW
  VOLUNTEERS
  /// Anyone who takes a paddock pass, including guests.
  CREDENTIAL_HOLDERS
}

/**
 * A waiver or indemnity document for an event or a whole series.
 * Legally required in real-world motorsport and absent from RaceOps until
 * now, which means organizers were running events on paper forms while every
 * other part of the weekend was here.
 * The body text is versioned rather than edited: a signature is only
 * meaningful against the exact wording that was signed, so changing the text
 * means issuing a new version and collecting signatures again. Superseded
 * versions are kept because the signatures against them still have to be
 * produced years later.
 */
model Waiver {
  id            String         @id @default(cuid())
  /// Exactly one of these is set; a CHECK enforces it.
  seriesId      String?
  eventId       String?
  title         String
  /// The wording itself. A signature means nothing without it.
  body          String         @db.Text
  /// Bumped whenever the wording changes; signatures record which they signed.
  version       Int            @default(1)
  audience      WaiverAudience @default(ALL_PARTICIPANTS)
  /// Blocks entry confirmation until signed, as most real-world events do.
  required      Boolean        @default(true)
  /// Youngest age that may sign for themselves; below it a guardian signs.
  minSigningAge Int?
  active        Boolean        @default(true)
  /// Set when a newer version replaced this one.
  supersededAt  DateTime?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  series     Series?           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  event      RaceEvent?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy  User?             @relation("WaiverAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  signatures WaiverSignature[]

  @@index([seriesId, active])
  @@index([eventId, active])
}

/**
 * One person's signature on one version of a waiver.
 * A typed-name e-signature, which is what the great majority of motorsport
 * organizers actually accept. What makes it hold up is not the signature
 * itself but everything recorded around it: the exact wording version, the
 * time, the address it came from and the browser it came from. Those fields
 * are the record, so none of them is optional in practice.
 * Signatures are never edited or deleted through any router. A signature
 * withdrawn is a new fact, not an erasure.
 */
model WaiverSignature {
  id               String   @id @default(cuid())
  waiverId         String
  /// The version of the wording that was on screen when they signed.
  waiverVersion    Int
  /// Null when the signer has no account — a guest crew member, a guardian.
  signerUserId     String?
  /// Typed exactly as they entered it; compared against their profile name.
  signedName       String
  signedEmail      String?
  /// The entry this signature covers, where it was collected against one.
  registrationId   String?
  /// Set when a guardian signed for a minor, with their relationship.
  guardianName     String?
  guardianRelation String?
  signedAt         DateTime @default(now())
  /// Evidence fields. Not decorative: they are what makes the signature hold.
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())

  waiver       Waiver             @relation(fields: [waiverId], references: [id], onDelete: Cascade)
  signer       User?              @relation("WaiverSigner", fields: [signerUserId], references: [id], onDelete: SetNull)
  registration EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([waiverId, signedAt])
  @@index([signerUserId])
  @@index([registrationId])
}

// ---------------------------------------------------------------------------
// Organizations, permissions & staff roles
// ---------------------------------------------------------------------------

/**
 * A granular capability.
 * Built-in `SeriesRole`s are bundles of these, and a custom staff role is a
 * bundle an organization writes itself — which is the whole point: a club that
 * has a "Chief Scrutineer" and a "Media Officer" should be able to say so,
 * rather than picking the closest of five fixed roles.
 * Permissions are checked individually at each call site, never derived from
 * "this role can do everything an admin can". Deriving them that way is how a
 * narrow custom role quietly gains admin powers.
 */
enum Permission {
  /// Organization settings, branding, and deleting the organization.
  ORG_MANAGE
  /// Invite staff, create roles, assign them.
  ORG_STAFF_MANAGE
  /// Series settings, classes, championship rules, branding.
  SERIES_MANAGE
  /// Create and publish events, run the schedule, decide entries.
  EVENT_MANAGE
  /// Issue penalties and work the stewards' queue.
  PENALTY_ISSUE
  /// Rule on appeals. Deliberately separate from issuing.
  APPEAL_DECIDE
  /// Manage volunteer shifts and signups.
  VOLUNTEER_MANAGE
  /// Read the audit trail of everyone's changes.
  AUDIT_READ
}

/**
 * An organization: the club, promoter or company behind a series or a team.
 * Optional throughout. A one-person league does not need one and never has to
 * create one — series and teams work standalone exactly as before. An
 * organization is what you reach for when several people share the work, or
 * when one body runs several series and wants one staff list and one look.
 */
model Organization {
  id           String  @id @default(cuid())
  name         String  @unique
  slug         String  @unique
  description  String? @db.Text
  websiteUrl   String?
  contactEmail String?
  location     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    OrganizationMembership[]
  staffRoles StaffRole[]
  series     Series[]
  teams      Team[]
  channels   ChatChannel[]
  branding   Branding?
}

/**
 * Built-in organization roles.
 * Kept tiny on purpose: everything finer-grained is a custom `StaffRole`.
 * OWNER exists so an organization can never be left with nobody who can
 * administer it.
 */
enum OrgRole {
  OWNER
  ADMIN
  /// Belongs to the organization but holds only what custom roles grant.
  STAFF
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(STAFF)
  /// What this person does, printed on the staff list: "Clerk of the Course".
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments  StaffAssignment[]

  @@unique([organizationId, userId])
  @@index([userId])
}

/**
 * A named bundle of permissions an organization or series defines itself.
 * "Chief Scrutineer", "Assistant Clerk", "Media Officer" — the roles clubs
 * actually have, rather than the five the platform guessed at. A role belongs
 * to an organization or to a single series; the series case matters because a
 * one-off championship should not have to create an organization first.
 */
model StaffRole {
  id             String       @id @default(cuid())
  organizationId String?
  seriesId       String?
  name           String
  description    String?
  permissions    Permission[]
  /// Chip colour on the staff list, so a roster is scannable.
  color          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  series       Series?           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  assignments  StaffAssignment[]
  channels     ChatChannel[]

  @@index([organizationId])
  @@index([seriesId])
}

/**
 * One person holding one custom role.
 * Scoped so a role granted at organization level applies across every series
 * it owns, while a role granted for one series stops there. A scrutineer hired
 * for a single round should not inherit the run of the championship.
 */
model StaffAssignment {
  id           String  @id @default(cuid())
  staffRoleId  String
  userId       String
  /// Set when the assignment came through an organization membership.
  membershipId String?
  /// Narrows an organization-level role to one series.
  seriesId     String?
  /// Narrows it further to a single event — a hired-in official for one round.
  eventId      String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffRole  StaffRole               @relation(fields: [staffRoleId], references: [id], onDelete: Cascade)
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership OrganizationMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  series     Series?                 @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  event      RaceEvent?              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([staffRoleId, userId, seriesId, eventId])
  @@index([userId])
  @@index([seriesId])
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Branding
// ---------------------------------------------------------------------------

/**
 * Look and feel for a public page.
 * One embeddable shape rather than a column per model, because the same four
 * things are wanted in four places and the resolution rules — event inherits
 * from series, series from organization, organization from RaceOps — only make
 * sense if they are all the same shape.
 * Colours are stored as authored and never trusted for contrast: a series that
 * picks pale yellow gets a readable foreground computed for it rather than
 * white-on-yellow. See `src/lib/branding.ts`.
 */
model Branding {
  id String @id @default(cuid())

  /// Exactly one owner; a CHECK enforces it.
  organizationId String? @unique
  seriesId       String? @unique
  eventId        String? @unique
  teamId         String? @unique

  /// Square-ish mark for cards, headers and the entry list.
  logoUrl      String?
  /// Wide image across the top of the landing page.
  bannerUrl    String?
  /// Authored hex, e.g. "#D91E1E". Foreground is derived, never stored.
  primaryColor String?
  accentColor  String?
  /// A short line under the name on the landing page.
  tagline      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  series       Series?       @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  event        RaceEvent?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Garage: parts inventory, telemetry & setup files, servicing
// ---------------------------------------------------------------------------

/**
 * Broad part categories.
 * Deliberately coarse. A team that wants "left front upright bearing" writes
 * that in the name; the category exists so a trailer inventory can be filtered
 * down to brakes on a Sunday morning, not to classify a catalogue.
 */
enum PartCategory {
  ENGINE
  DRIVETRAIN
  SUSPENSION
  BRAKES
  TIRES_WHEELS
  BODYWORK
  ELECTRICAL
  FLUIDS
  SAFETY
  CONSUMABLES
  TOOLS
  OTHER
}

/**
 * One line of a team's parts stock.
 *
 * `quantity` is a cached balance, not the source of truth: every change goes
 * through an `InventoryMovement` and the balance is recomputed from the
 * movement. A count that can be typed over directly loses the answer to "who
 * took the last set of pads and when", which is the question a Sunday morning
 * actually asks.
 */
model InventoryItem {
  id         String       @id @default(cuid())
  teamId     String
  name       String
  partNumber String?
  category   PartCategory @default(OTHER)
  /// Where it lives: "Trailer shelf 3", "Shop rack B".
  location   String?
  /// Current stock. Maintained through movements; see src/lib/inventory.ts.
  quantity   Int          @default(0)
  /// Warn below this. Null means this item is never worth a reorder warning.
  minQuantity Int?
  /// "each", "set", "litre", "metre" — teams stock all four.
  unit       String       @default("each")
  unitCostMinor Int?
  currency   String       @default("USD")
  supplier   String?
  notes      String?      @db.Text
  /// Fits only this car. Null means it fits anything the team runs.
  carId      String?
  /// Retired lines stay for the history but drop out of the pick lists.
  active     Boolean      @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team      Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  car       Car?                @relation(fields: [carId], references: [id], onDelete: SetNull)
  createdBy User?               @relation("InventoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  movements InventoryMovement[]

  @@index([teamId, active, category])
  @@index([carId])
  @@index([createdById])
}

enum StockMoveKind {
  /// Stock arrived: a delivery, or an opening count.
  RECEIVED
  /// Fitted to a car, used up, or otherwise gone.
  CONSUMED
  /// A stocktake correction. Carries a reason for the same purpose an
  /// accounting adjustment does.
  ADJUSTED
  /// Came back on the shelf — took it to the track, did not need it.
  RETURNED
}

/**
 * One change to a stock line, and the balance it produced.
 *
 * The balance is stored rather than derived on read so the ledger stays
 * readable after somebody corrects an old row: "we were at 4 when this was
 * written" is a fact about that moment, and recomputing it from the current
 * item would rewrite history every time the stock changed.
 */
model InventoryMovement {
  id      String        @id @default(cuid())
  itemId  String
  kind    StockMoveKind
  /// Signed change applied to the item. Negative for CONSUMED.
  delta   Int
  /// The item's quantity immediately after this movement.
  balance Int
  reason  String?
  /// Where it went, when it went somewhere.
  eventId   String?
  serviceId String?
  userId    String?
  createdAt DateTime @default(now())

  item    InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  event   RaceEvent?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  service CarService?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  user    User?         @relation("StockMover", fields: [userId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
  @@index([eventId])
  @@index([serviceId])
  @@index([userId])
}

/**
 * What a stored file is, which decides where it is offered and how it is read.
 * Telemetry and setups share a model because they share every question worth
 * asking of them — which car, which track, which session, whose lap, how quick
 * — and differ only in what opens them.
 */
enum GarageFileKind {
  /// A logger export: MoTeC ld, AiM drk, CSV, a sim's telemetry file.
  TELEMETRY
  /// A setup sheet: a sim's setup export, or a scanned corner-weight sheet.
  SETUP
  /// Anything else the crew keeps against a car: a wiring diagram, a manual.
  DOCUMENT
}

/**
 * A file a team keeps against a car.
 *
 * Held as a record with metadata rather than a folder of blobs, because the
 * useful query is never "list the files" — it is "the setup we ran at Sebring
 * in the damp, and the lap that came out of it".
 */
model GarageFile {
  id     String         @id @default(cuid())
  teamId String
  kind   GarageFileKind
  name   String
  /// Where the bytes are. Object storage when configured, else a link.
  url         String
  fileName    String?
  contentType String?
  sizeBytes   Int?

  carId         String?
  eventId       String?
  sessionId     String?
  trackLayoutId String?
  /// Whose run this is.
  driverUserId  String?
  /// Conditions the run or setup belongs to: "damp, 12°C, green".
  conditions    String?
  /// Best lap in this file, in milliseconds. What makes a setup findable
  /// later: "the quickest we have been here" is the reason to reopen one.
  bestLapMs     Int?
  notes         String? @db.Text
  tags          String[]

  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  car         Car?          @relation(fields: [carId], references: [id], onDelete: SetNull)
  event       RaceEvent?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  session     EventSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  trackLayout TrackLayout?  @relation(fields: [trackLayoutId], references: [id], onDelete: SetNull)
  driver      User?         @relation("GarageFileDriver", fields: [driverUserId], references: [id], onDelete: SetNull)
  uploadedBy  User?         @relation("GarageFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([teamId, kind, createdAt])
  @@index([carId, kind])
  @@index([trackLayoutId, kind])
  @@index([eventId])
  @@index([sessionId])
  @@index([driverUserId])
  @@index([uploadedById])
}

enum ServiceKind {
  /// Routine work on an interval: fluids, belts, a gearbox refresh.
  SCHEDULED
  /// Something broke.
  REPAIR
  /// Full component rebuild.
  REBUILD
  /// A check with no work implied.
  INSPECTION
  /// Deliberate change to the car, not a restoration of it.
  UPGRADE
}

enum ServiceStatus {
  PLANNED
  IN_PROGRESS
  DONE
  /// Known about, decided against for now. Distinct from done and from
  /// planned: a deferred job should stop nagging without being forgotten.
  DEFERRED
}

/**
 * A job on a car: what was done, when, by whom, and when it comes round again.
 *
 * `nextDueOn` and `nextDueHours` are both optional and both meaningful. Some
 * jobs come round on the calendar (an annual logbook inspection) and some on
 * running hours (an engine rebuild), and a team that tracks hours wants the
 * second without inventing a date for it.
 */
model CarService {
  id        String        @id @default(cuid())
  carId     String
  kind      ServiceKind   @default(SCHEDULED)
  status    ServiceStatus @default(PLANNED)
  /// What was worked on: "Left front upright", "Gearbox", "Fire system".
  component String
  description String? @db.Text

  /// Running hours on the car when the work was done.
  hoursAtService Float?
  /// Recorded against an event when the work happened at a race.
  eventId        String?
  performedById  String?
  performedOn    DateTime?
  costMinor      Int?
  currency       String    @default("USD")

  nextDueOn    DateTime?
  nextDueHours Float?

  notes       String? @db.Text
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  car         Car                 @relation(fields: [carId], references: [id], onDelete: Cascade)
  event       RaceEvent?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  performedBy User?               @relation("ServicePerformer", fields: [performedById], references: [id], onDelete: SetNull)
  createdBy   User?               @relation("ServiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  partsUsed   InventoryMovement[]

  @@index([carId, status])
  @@index([eventId])
  @@index([performedById])
  @@index([createdById])
}

enum PitStopKind {
  FUEL
  TIRES
  DRIVER_CHANGE
  REPAIR
  /// Serving a stop-go or drive-through handed down by the stewards.
  PENALTY_SERVE
  OTHER
}

enum PitStopStatus {
  PLANNED
  COMPLETED
  /// The plan changed and this stop never happened. Kept rather than deleted:
  /// a stop that was skipped is why the fuel numbers stopped adding up.
  SKIPPED
}

/**
 * A pit stop a team intends to make, and what actually happened.
 *
 * Planned against an entry rather than a car, because the plan belongs to the
 * weekend: the same car in two events has two independent stop sequences.
 * Both `targetLap` and `targetAt` are optional — a sprint plans by lap, an
 * enduro by the clock, and a wet race by neither until the radio says so.
 */
model PitStopPlan {
  id             String        @id @default(cuid())
  registrationId String
  sessionId      String?
  /// Stop number within the plan, 1-based. What the pit board counts down to.
  sequence       Int
  kind           PitStopKind   @default(FUEL)
  status         PitStopStatus @default(PLANNED)

  targetLap Int?
  targetAt  DateTime?

  /// Driver getting in and getting out. Null on a stop with no change.
  driverInId  String?
  driverOutId String?
  /// Planned fuel, in litres.
  fuelLitres  Float?
  tireSetId   String?

  /// Stationary time the crew is aiming for, and what it took.
  plannedSeconds Int?
  actualAt       DateTime?
  actualSeconds  Int?

  notes       String? @db.Text
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registration EventRegistration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  session      EventSession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  driverIn     RegistrationDriver? @relation("PitStopDriverIn", fields: [driverInId], references: [id], onDelete: SetNull)
  driverOut    RegistrationDriver? @relation("PitStopDriverOut", fields: [driverOutId], references: [id], onDelete: SetNull)
  tireSet      TireSet?            @relation(fields: [tireSetId], references: [id], onDelete: SetNull)
  createdBy    User?               @relation("PitStopCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([registrationId, sequence])
  @@index([registrationId, status])
  @@index([sessionId])
  @@index([tireSetId])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Departmental channels & direct messages
// ---------------------------------------------------------------------------

enum ChannelKind {
  /// Everyone in the scope. A team's whole roster, an event's whole paddock.
  OPEN
  /**
   * Only people holding one of the listed roles in the scope. This is the
   * engineers' channel, the crew channel, race control's channel — the one
   * you can say "we are three laps short on fuel" in without it reaching the
   * whole paddock.
   */
  DEPARTMENT
}

/**
 * A chat room narrower than its scope.
 *
 * Membership is *derived*, never stored: you are in a department channel while
 * you hold one of its roles, and you are out of it the moment you do not. A
 * stored member list would leave a departed engineer reading the engineers'
 * channel until somebody remembered to prune it, which is exactly the failure
 * a private channel exists to prevent.
 *
 * Exactly one scope is set; a CHECK enforces it. The scope decides which role
 * list applies — `teamRoles` for a team, `seriesRoles` for a series or event,
 * `orgRoles` for an organization — and `staffRoleId` narrows an organization
 * or series channel to one custom role.
 */
model ChatChannel {
  id             String  @id @default(cuid())
  teamId         String?
  eventId        String?
  seriesId       String?
  organizationId String?

  kind        ChannelKind @default(DEPARTMENT)
  name        String
  /// URL-safe name, unique within the scope.
  slug        String
  description String?

  /// Who may read and post. All empty on an OPEN channel.
  teamRoles   TeamRole[]
  seriesRoles SeriesRole[]
  orgRoles    OrgRole[]
  staffRoleId String?

  /**
   * Whether entrants' team roles count on an event channel.
   *
   * An event channel scoped by `teamRoles` is the cross-paddock department
   * room: every engineer entered in the meeting, from every team. Off, the
   * roles are read against the series' own staff instead.
   */
  includesEntrantTeams Boolean @default(false)

  /// Archived channels stay readable and stop accepting messages.
  archived    Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team         Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  event        RaceEvent?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  series       Series?       @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffRole    StaffRole?    @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("ChannelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  messages     ChatMessage[]

  @@unique([teamId, slug])
  @@unique([eventId, slug])
  @@unique([seriesId, slug])
  @@unique([organizationId, slug])
  @@index([teamId, archived])
  @@index([eventId, archived])
  @@index([staffRoleId])
  @@index([createdById])
}

/**
 * A private conversation between people, independent of any team or event.
 *
 * `pairKey` is set only on two-person threads: the two user ids sorted and
 * joined, so "message this person" finds the existing thread instead of
 * opening a second one beside it. Group threads leave it null, because three
 * people can reasonably want two different group conversations.
 */
model DirectThread {
  id      String  @id @default(cuid())
  pairKey String? @unique
  /// Optional name, for group threads that want one.
  subject String?
  /// Bumped on every message so an inbox sorts without touching messages.
  lastMessageAt DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdBy    User?               @relation("ThreadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants DirectParticipant[]
  messages     ChatMessage[]

  @@index([lastMessageAt])
  @@index([createdById])
}

model DirectParticipant {
  id       String @id @default(cuid())
  threadId String
  userId   String
  /// When this person last opened the thread. Drives the unread count.
  readAt   DateTime?
  /**
   * Leaving hides the thread from this person without destroying anyone
   * else's copy of the conversation. A message from the other side clears it,
   * because a reply to a conversation you left is still addressed to you.
   */
  leftAt    DateTime?
  createdAt DateTime  @default(now())

  thread DirectThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User         @relation("ThreadParticipant", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId, leftAt])
}

// ---------------------------------------------------------------------------
// Hiring: interviews, offers
// ---------------------------------------------------------------------------

enum InterviewKind {
  VIDEO_CALL
  PHONE
  IN_PERSON
  /// A seat evaluation in the car. Distinct from a conversation because it
  /// needs a circuit, a date and usually a licence — the logistics are the
  /// interview.
  TRACK_TEST
  /// A trial working a real meeting, which is how most crew are actually
  /// hired.
  WORK_TRIAL
}

enum InterviewStatus {
  /// Times offered, waiting on the applicant.
  PROPOSED
  /// A time is agreed.
  CONFIRMED
  /// The applicant could not make any of the proposed times.
  DECLINED
  COMPLETED
  CANCELED
}

/**
 * An interview against one application.
 *
 * Times are *proposed* rather than dictated. The friction this feature exists
 * to remove is the email thread where a team suggests one slot, the applicant
 * is at work, and four days go by — so a team offers several and the applicant
 * picks, which is one round trip instead of five.
 *
 * `scheduledAt` is null until a slot is chosen, and is then a copy of that
 * slot's time so everything downstream can read one field.
 */
model Interview {
  id            String          @id @default(cuid())
  applicationId String
  kind          InterviewKind   @default(VIDEO_CALL)
  status        InterviewStatus @default(PROPOSED)

  /// Set when a proposed slot is confirmed.
  scheduledAt     DateTime?
  durationMinutes Int       @default(30)
  /// Meeting link, phone number, or the address of the shop or circuit.
  location        String?
  /// Shown to the applicant: what to expect, what to bring.
  agenda          String?   @db.Text
  /// The team's own notes. Never shown to the applicant.
  privateNotes    String?   @db.Text
  /// Written after the fact. Also team-only.
  outcome         String?   @db.Text

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  application Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation("InterviewCreator", fields: [createdById], references: [id], onDelete: SetNull)
  slots       InterviewSlot[]

  @@index([applicationId, status])
  @@index([scheduledAt])
  @@index([createdById])
}

/**
 * One time on offer for an interview.
 *
 * Stored in UTC and rendered in whoever is looking at it's own zone. A team in
 * Charlotte interviewing a driver in Munich is the ordinary case here, and a
 * naive local time would put somebody on a call at 3am.
 */
model InterviewSlot {
  id          String   @id @default(cuid())
  interviewId String
  startsAt    DateTime
  /// The one the applicant picked. At most one per interview; enforced by a
  /// partial unique index.
  chosen      Boolean  @default(false)
  createdAt   DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, startsAt])
  @@index([interviewId, startsAt])
}

/**
 * What somebody is being paid, and on what footing.
 *
 * `UNPAID` is a first-class option rather than a zero rate. Most club crew are
 * volunteers and a great many seats are paid by the driver, so a form that
 * insists on a number would have people typing 0 into a field the platform
 * then treats as a wage — and a payroll built on that is wrong in a way nobody
 * notices until somebody is owed money.
 */
enum PayBasis {
  HOURLY
  DAILY
  PER_EVENT
  MONTHLY
  /// One figure for the whole season.
  SEASON
  UNPAID
}

enum OfferStatus {
  /// Being written. The applicant cannot see it.
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  /// Pulled by the team before it was answered.
  WITHDRAWN
  /// Ran past its own expiry without an answer.
  EXPIRED
}

/**
 * A formal offer against an application.
 *
 * Separate from simply marking an application accepted, because the two are
 * genuinely different acts: "you're in" is a decision the team makes alone,
 * and an offer is a proposition the applicant answers. Both routes end with
 * somebody on the roster, and a team that does not want paperwork never has to
 * make one.
 *
 * Accepting an offer is what puts the person on the roster, at the role and
 * rate the offer named — which is the whole point of the record. Hiring
 * somebody and then separately typing them into the roster and again into the
 * pay rates is where the details drift apart.
 */
model Offer {
  id            String      @id @default(cuid())
  applicationId String
  teamId        String
  status        OfferStatus @default(DRAFT)

  /// The seat on the roster this offer is for.
  role  TeamRole @default(MEMBER)
  /// What it would be called: "Data Engineer", "Bronze-rated driver".
  title String?

  basis       PayBasis @default(UNPAID)
  /// Minor units. Null on an UNPAID offer, and on one where pay is still to
  /// be agreed — those are different from zero and are stored differently.
  amountMinor Int?
  currency    String   @default("USD")
  /// Anything the amount does not cover: travel, kit, a share of prize money.
  extras      String?  @db.Text

  startDate DateTime?
  endDate   DateTime?
  /// Which rounds it covers, in the team's own words.
  scope     String?
  terms     String?   @db.Text

  /// After this, an unanswered offer expires rather than hanging forever.
  expiresAt     DateTime?
  sentAt        DateTime?
  respondedAt   DateTime?
  /// The applicant's reply in their own words.
  responseNote  String?   @db.Text
  withdrawnAt   DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("OfferCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([applicationId, status])
  @@index([teamId, status])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Payroll
// ---------------------------------------------------------------------------

/**
 * What a team pays one person, standing.
 *
 * Kept apart from the offer that set it because a rate outlives the offer:
 * people get raises, move from per-event to a season deal, and stay on the
 * team for years. The offer records what was agreed once; this records what is
 * true now, and a pay run is built from it.
 */
model PayRate {
  id     String @id @default(cuid())
  teamId String
  userId String

  basis       PayBasis @default(PER_EVENT)
  amountMinor Int?
  currency    String   @default("USD")
  /// What this rate is for, where somebody does two jobs.
  label       String?
  effectiveFrom DateTime  @default(now())
  /// Set when a rate is superseded. History is kept rather than overwritten —
  /// a pay run from March has to stay explicable in December.
  effectiveTo   DateTime?
  notes         String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team      Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User          @relation("PayRateSubject", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("PayRateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines     PayrollLine[]

  @@index([teamId, userId, effectiveTo])
  @@index([userId])
  @@index([createdById])
}

enum PayRunStatus {
  /// Being assembled. Lines can be added, changed and removed.
  DRAFT
  /// Signed off. Amounts are frozen; only payment marks may still change.
  APPROVED
  /// Everything on it has been paid.
  PAID
  CANCELED
}

/**
 * One period's pay for a team.
 *
 * **This is not a payroll processor.** It does not withhold tax, file
 * anything, or move money. It works out what is owed, records what was paid,
 * and exports the figures for whoever actually runs the payroll — an
 * accountant, a bureau, or a bank transfer. That boundary is stated on the
 * page as well as here, because a team believing otherwise would be a
 * genuinely costly mistake.
 */
model PayRun {
  id     String       @id @default(cuid())
  teamId String
  /// What the team calls it: "March 2026", "Sebring 12h".
  label  String
  status PayRunStatus @default(DRAFT)

  periodStart DateTime
  periodEnd   DateTime
  /// Covers one meeting, where a team pays per event rather than per month.
  eventId     String?
  notes       String?  @db.Text

  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team       Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  event      RaceEvent?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  approvedBy User?         @relation("PayRunApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy  User?         @relation("PayRunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines      PayrollLine[]

  @@index([teamId, status, periodStart])
  @@index([eventId])
  @@index([approvedById])
  @@index([createdById])
}

/**
 * One person's pay on one run.
 *
 * `amountMinor` is stored rather than derived on read, and that is deliberate:
 * a run approved in March must still show the same figure in December, even
 * after the person's standing rate has changed twice. The rate is a starting
 * point, not a formula the line keeps referring back to.
 *
 * `payeeName` exists for the mechanic who does two weekends a year and has no
 * account. Excluding them would push a chunk of a real team's costs back onto
 * the spreadsheet this is meant to replace.
 */
model PayrollLine {
  id       String  @id @default(cuid())
  payRunId String
  userId   String?
  /// Used when there is no account behind the person.
  payeeName String?

  /// What the work was: "Race engineer, Sebring 12h".
  description String
  basis       PayBasis @default(PER_EVENT)
  /// Hours, days or events — whatever the basis counts.
  quantity    Float    @default(1)
  rateMinor   Int      @default(0)
  /// The figure actually owed, frozen at the time it was worked out.
  amountMinor Int      @default(0)
  currency    String   @default("USD")

  /// Anything not covered by rate × quantity: a bonus, a travel reimbursement,
  /// a deduction. Signed, and added to the amount above.
  adjustmentMinor Int     @default(0)
  adjustmentNote  String?

  /// The standing rate this line was built from, where it was.
  payRateId String?
  eventId   String?

  paidAt           DateTime?
  /// Bank reference, cheque number, "cash". Free text on purpose: the platform
  /// does not move the money and should not pretend to know how it moved.
  paymentReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payRun  PayRun     @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  user    User?      @relation("PayrollPayee", fields: [userId], references: [id], onDelete: SetNull)
  payRate PayRate?   @relation(fields: [payRateId], references: [id], onDelete: SetNull)
  event   RaceEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([payRunId])
  @@index([userId, paidAt])
  @@index([payRateId])
  @@index([eventId])
}
